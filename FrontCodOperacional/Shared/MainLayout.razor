@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims;
@using FrontCodOperacional.Models.Auth

@inject Services.Api.AuthApiService _authApi
@inject Auth.CustomAuthStateProvider AuthProvider
@inject NavigationManager Nav
@inject Auth.TokenStorage _storage
@inject IJSRuntime JS

@inherits LayoutComponentBase

<div class="layout @(collapsed ? "collapsed" : "")">
    <aside class="sidebar">
        <div class="sidebar-header">
            <button class="toggle-btn" @onclick="ToggleSidebar">
                ☰
            </button>
        </div>

        <NavMenu Collapsed="collapsed" />
    </aside>

    <main class="content">

        <MainHeader />

        <div class="topbar">
            <AuthorizeView>
                <Authorized>
                    <button class="logout-btn" @onclick="CerrarSesion">
                        Cerrar sesión
                    </button>
                </Authorized>
            </AuthorizeView>
        </div>

        <div class="workspace">
            <Toast />
            @Body
        </div>

       <MainFooter />
    </main>
</div>

@code {
    private bool collapsed = false;

    protected override async Task OnInitializedAsync()
    {
        var value = await JS.InvokeAsync<string>("localStorage.getItem", "sidebar");
        collapsed = value == "true";
    }

    private async Task ToggleSidebar()
    {
        collapsed = !collapsed;
        await JS.InvokeVoidAsync("localStorage.setItem", "sidebar", collapsed);
    }

    private async Task CerrarSesion()
    {
        var refreshToken = await _storage.GetRefreshToken();

        if (!string.IsNullOrEmpty(refreshToken))
        {
            await _authApi.Logout(new RefreshRequest
            {
                RefreshToken = refreshToken
            });
        }

        // 🔴 luego limpiar cliente
        await AuthProvider.Logout();

        Nav.NavigateTo("/login", true);
    }
}