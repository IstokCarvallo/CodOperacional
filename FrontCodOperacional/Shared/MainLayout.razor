@using FrontCodOperacional.Services.UI
@using FrontCodOperacional.Models.Auth

@inject Services.Api.AuthApiService _authApi
@inject Auth.CustomAuthStateProvider AuthProvider
@inject CurrentUserService UserService
@inject NavigationManager Nav
@inject Auth.TokenStorage _storage
@inject IJSRuntime JS

@inherits LayoutComponentBase

<div class="layout @(collapsed ? "collapsed" : "") @(mobileOpen ? "mobile-open" : "")">
    <div class="overlay" @onclick="CloseSidebarMobile" OnLogout="CerrarSesion"></div>
    <aside class="sidebar">
        <NavMenu Collapsed="collapsed" />
    </aside>

    <main class="content">

        <MainHeader OnToggle="ToggleSidebar" OnLogout="CerrarSesion" />

        <div class="workspace">
            <Toast />
            @Body
        </div>

       <MainFooter />
    </main>
</div>

@code {
    private bool collapsed = false;
    private bool mobileOpen;

    protected override async Task OnInitializedAsync()
    {
        var value = await JS.InvokeAsync<string>("localStorage.getItem", "sidebar");
        collapsed = value == "true";

        Nav.LocationChanged += (_, __) =>
        {
            mobileOpen = false;
            StateHasChanged();
        };


        await JS.InvokeVoidAsync("theme.load");
    }

    private void CloseSidebarMobile()
    {
        mobileOpen = false;
    }

    private async Task ToggleSidebar()
    {
        var isMobile = await JS.InvokeAsync<bool>("layoutUtils.isMobile");

        if (isMobile)
        {
            mobileOpen = !mobileOpen;  
        }
        else
        {
            collapsed = !collapsed;    
            await JS.InvokeVoidAsync("localStorage.setItem", "sidebar", collapsed);
        }
    }

    private async Task CerrarSesion()
    {
        var refreshToken = await _storage.GetRefreshToken();

        if (!string.IsNullOrEmpty(refreshToken))
        {
            await _authApi.Logout(new RefreshRequest
            {
                RefreshToken = refreshToken
            });
        }

        await AuthProvider.Logout();
        UserService.Clear();
        Nav.NavigateTo("/login", true);
    }
}