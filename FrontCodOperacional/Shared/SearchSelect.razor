@typeparam TItem

<div class="position-relative">

    <input class="form-control pe-5"
           placeholder="@Placeholder"
           value="@SearchText"
           @oninput="OnInputChange" 
           @onkeydown="OnKeyDown" />

    <span class="position-absolute top-50 end-0 translate-middle-y me-3">

        @if (Loading)
        {
            <span>🔄</span>
        }
        else if (!string.IsNullOrWhiteSpace(SearchText))
        {
            <span>🔍</span> 
        }

    </span>

    @if (Loading)
    {
        <div class="small text-muted mt-1">Buscando...</div>
    }

    @if (Items.Any())
    {
        <ul class="list-group position-absolute w-100 shadow"
            style="z-index:1000; max-height:250px; overflow:auto;">
            
            @for (int i = 0; i < Items.Count; i++)
            {
                var item = Items[i];

                <li class="list-group-item list-group-item-action @(i == IndexActivo ? "active" : "")"
                    style="cursor:pointer"
                    @onclick="() => SelectItem(item)">
                    @ItemText(item)
                </li>
            }
        </ul>
    }
    @if (!Loading && SinResultados)
    {
        <div class="list-group position-absolute w-100 shadow"
             style="z-index:1000;">
            <div class="list-group-item text-muted">
                ❌ Sin resultados para "@SearchText"
            </div>
        </div>
    }

</div>

@code {

    [Parameter] public Func<string, Task<List<TItem>>> SearchMethod { get; set; } = default!;
    [Parameter] public Func<TItem, string> ItemText { get; set; } = default!;
    [Parameter] public EventCallback<TItem> OnSelected { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Buscar...";

    private List<TItem> Items = new();
    private string SearchText = "";
    private bool Loading = false;
    private bool SinResultados = false;
    private int IndexActivo = -1;

    private CancellationTokenSource? _cts;

    private async Task OnInputChange(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        _cts?.Cancel();
        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, _cts.Token);

            if (string.IsNullOrWhiteSpace(SearchText))
            {
                Items.Clear();
                SinResultados = false;
                return;
            }

            Loading = true;

            Items = await SearchMethod(SearchText);
            IndexActivo = -1;
            SinResultados = !Items.Any();
        }
        catch (TaskCanceledException) { }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectItem(TItem item)
    {
        // if (SearchText.Length < 3)
        // {
        //     Items.Clear();
        //     return;
        // }

        SearchText = ItemText(item);
        Items.Clear();
        SinResultados = false;
        IndexActivo = -1;

        await OnSelected.InvokeAsync(item);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!Items.Any())
            return;

        switch (e.Key)
        {
            case "ArrowDown":
                IndexActivo = (IndexActivo + 1) % Items.Count;
                break;

            case "ArrowUp":
                IndexActivo = IndexActivo <= 0 ? Items.Count - 1 : IndexActivo - 1;
                break;

            case "Enter":
                if (IndexActivo >= 0 && IndexActivo < Items.Count)
                    await SelectItem(Items[IndexActivo]);
                else
                    await SelectItem(Items.First());
                break;

            case "Escape":
                Items.Clear();
                SinResultados = false;
                IndexActivo = -1;
                break;
        }
    }
}