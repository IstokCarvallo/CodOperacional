@typeparam TItem

<div class="search-select">

    <div class="search-select-input-wrapper">

        <input class="search-select-input"
               placeholder="@Placeholder"
               value="@SearchText"
               @oninput="OnInputChange"
               @onkeydown="OnKeyDown" />

        <span class="search-select-indicator">

            @if (Loading)
            {
                <i class="fa-solid fa-spinner fa-spin"></i>
            }
            else if (!string.IsNullOrWhiteSpace(SearchText))
            {
                <i class="fa-solid fa-magnifying-glass"></i>
            }

        </span>

    </div>

    @if (Loading)
    {
        <div class="search-select-status">
            Buscando...
        </div>
    }

    @if (Items.Any())
    {
        <ul class="search-select-results">

            @for (int i = 0; i < Items.Count; i++)
            {
                var item = Items[i];

                <li class="search-select-item @(i == IndexActivo ? "active" : "")"
                    @onclick="() => SelectItem(item)">

                    @ItemText(item)

                </li>
            }

        </ul>
    }

    @if (!Loading && SinResultados)
    {
        <div class="search-select-results">

            <div class="search-select-empty">
                <i class="fa-regular fa-folder-open"></i>
                <span>
                    Sin resultados para "@SearchText"
                </span>
            </div>

        </div>
    }

</div>

@code {

    [Parameter]
    public Func<string, Task<List<TItem>>> SearchMethod { get; set; } = default!;

    [Parameter]
    public Func<TItem, string> ItemText { get; set; } = default!;

    [Parameter]
    public EventCallback<TItem> OnSelected { get; set; }

    [Parameter]
    public string Placeholder { get; set; } = "Buscar...";

    private List<TItem> Items = new();

    private string SearchText = "";

    private bool Loading = false;

    private bool SinResultados = false;

    private int IndexActivo = -1;

    private CancellationTokenSource? _cts;

    private async Task OnInputChange(ChangeEventArgs e)
    {
        SearchText = e.Value?.ToString() ?? "";

        _cts?.Cancel();
        _cts?.Dispose();

        _cts = new CancellationTokenSource();

        try
        {
            await Task.Delay(300, _cts.Token);

            if (string.IsNullOrWhiteSpace(SearchText))
            {
                Items.Clear();
                SinResultados = false;
                IndexActivo = -1;

                return;
            }

            Loading = true;

            Items = await SearchMethod(SearchText);

            IndexActivo = -1;

            SinResultados = !Items.Any();
        }
        catch (TaskCanceledException)
        {
        }
        finally
        {
            Loading = false;
            StateHasChanged();
        }
    }

    private async Task SelectItem(TItem item)
    {
        SearchText = ItemText(item);

        Items.Clear();

        SinResultados = false;

        IndexActivo = -1;

        await OnSelected.InvokeAsync(item);
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (!Items.Any())
            return;

        switch (e.Key)
        {
            case "ArrowDown":

                IndexActivo =
                    (IndexActivo + 1) % Items.Count;

                break;

            case "ArrowUp":

                IndexActivo =
                    IndexActivo <= 0
                        ? Items.Count - 1
                        : IndexActivo - 1;

                break;

            case "Enter":

                if (IndexActivo >= 0 &&
                    IndexActivo < Items.Count)
                {
                    await SelectItem(Items[IndexActivo]);
                }
                else
                {
                    await SelectItem(Items.First());
                }

                break;

            case "Escape":

                Items.Clear();

                SinResultados = false;

                IndexActivo = -1;

                break;
        }
    }
}