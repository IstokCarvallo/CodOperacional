@using FrontCodOperacional.Services.UI

@inject IJSRuntime JS
@inject CurrentUserService UserService
@inject NavigationManager Navigation


<header class="main-header">
    <div class="left">
        <button class="toggle-btn" @onclick="OnToggle"><i class="fa-solid fa-bars"></i></button>
        <span class="system-title">Código Operacional</span>
    </div>

    <div class="right">
        <!-- BOTÓN TEMA -->
        <button class="theme-btn" @onclick="ToggleTheme" title="Cambiar tema">
            <i class="fa-regular fa-moon"></i>
        </button>

        <AuthorizeView>
            <Authorized>
                <div class="user-menu" @ref="menuRef">

                    <!-- BOTÓN USUARIO -->
                    <button class="user-trigger" @onclick="ToggleMenu">
                        <div class="avatar">
                            @initials
                        </div>

                        <div class="user-meta">
                            <span class="user-name">
                                @name
                            </span>

                            <span class="user-role">
                                @role
                            </span>
                        </div>
                        <i class="fa-solid fa-chevron-down chevron"></i>
                    </button>

                    <!-- DROPDOWN -->
                    <div class="dropdown @(open ? "show" : "")">
                        <div class="dropdown-header">
                            <div class="avatar large">
                                @initials
                            </div>

                            <div class="dropdown-user-info">
                                <div class="dropdown-name">
                                    @name
                                </div>

                                <div class="dropdown-role">
                                    @role
                                </div>
                            </div>
                        </div>

                        <div class="dropdown-divider"></div>

                        <button class="dropdown-item" @onclick="GoProfile">
                            <i class="fa-regular fa-user"></i>
                            <span>Mi Perfil</span>
                        </button>                       

                        <button class="dropdown-item">
                            <i class="fa-solid fa-gear"></i>
                            <span>Configuración</span>
                        </button>

                        <button class="dropdown-item" @onclick="GoChangePassword">
                            <i class="fa-solid fa-key"></i>
                            <span>Cambiar contraseña</span>
                        </button>

                        <button class="dropdown-item" @onclick="GoAbout">
                            <i class="fa-solid fa-circle-info"></i>
                            <span>Acerca de</span>
                        </button>

                        <div class="dropdown-divider"></div>

                        <button class="dropdown-item logout"
                                @onclick="HandleLogout"
                                @onclick:stopPropagation="true">

                            <i class="fa-solid fa-right-from-bracket"></i>

                            <span>Cerrar sesión</span>
                        </button>
                    </div>
                </div>
            </Authorized>
        </AuthorizeView>
    </div>
</header>

@code {
    [Parameter] public EventCallback OnToggle { get; set; }
    [Parameter] public EventCallback OnLogout { get; set; }

    [Inject] AuthenticationStateProvider AuthStateProvider { get; set; } = default!;


    private bool open = false;
    private string? name;
    private string? role;
    private string initials = "?";
    private ElementReference menuRef;

    protected override async Task OnInitializedAsync()
    {
        name = await UserService.GetName();
        role = await UserService.GetRole();
        initials = await UserService.GetInitials();
        AuthStateProvider.AuthenticationStateChanged += AuthChangedHandler;
    }

    private void GoAbout()
    {
        open = false;
        Navigation.NavigateTo("/account/about");
    }

    private void GoChangePassword()
    {
        open = false;

        Navigation.NavigateTo("/account/change-password");
    }

    private void GoProfile()
    {
        open = false;
        Navigation.NavigateTo("/account/profile");
    }

    [JSInvokable]
    public void CloseDropdown()
    {
        if (open)
        {
            open = false;
            StateHasChanged();
        }
    }

    private void ToggleMenu()
    {
        open = !open;
    }

    private async Task ToggleTheme()
    {
        await JS.InvokeVoidAsync("theme.toggle");
    }

    private async Task HandleLogout()
    {
        if (OnLogout.HasDelegate)
            await OnLogout.InvokeAsync();
    }

    private void AuthChangedHandler(Task<AuthenticationState> task)
    {
        _ = HandleAuthChangedAsync(task);
    }

   
    private async Task HandleAuthChangedAsync(Task<AuthenticationState> task)
    {
        var state = await task;
        UserService.Clear();

        if (state.User.Identity?.IsAuthenticated == true)
        {
            name = await UserService.GetName();
            role = await UserService.GetRole();
            initials = await UserService.GetInitials();
        }
        else
        {
            name = null;
            role = null;
            initials = "?";
        }

        await InvokeAsync(StateHasChanged);
    }

    // ✔ LIMPIAR EVENTO (importante)
    public void Dispose()
    {
        AuthStateProvider.AuthenticationStateChanged -= AuthChangedHandler;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync(
                "dropdown.init",
                ".user-menu",
                DotNetObjectReference.Create(this)
            );
        }
    }
}