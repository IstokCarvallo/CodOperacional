@using Microsoft.AspNetCore.Components.Authorization

<AuthorizeView>
    <Authorized Context="authState">

        <nav class="nav-section" @(Collapsed ? "collapsed" : "" )">

            <!-- GENERAL -->
            <div class="nav-group">
                <span class="nav-title">General</span>

                <ul>
                    <li>
                        <NavLink href="/" Match="NavLinkMatch.All" class="nav-link"
                                 title="Home" data-tooltip="Home">
                            <div class="left">
                                <span class="icon"><i class="fa-solid fa-house"></i></span>
                                @if (!Collapsed)
                                {   
                                    <span class="link-text">Inicio</span>
                                }
                            </div>
                        </NavLink>
                    </li>
                </ul>
            </div>

            <!-- OPERACIÓN -->
            <div class="nav-group">
                <span class="nav-title">Operación</span>
                <ul>
                    <li>
                        <NavLink href="/planta" Match="NavLinkMatch.Prefix" class="nav-link"
                                 title="Plantas" data-tooltip="Packing">
                            <div class="left">
                                <span class="icon"><i class="fa-solid fa-industry"></i></span>
                                @if (!Collapsed)
                                {
                                    <span class="link-text">Packing</span>
                                }
                            </div>
                        </NavLink>
                    </li>

                    <li>
                        <NavLink href="/cuartel" Match="NavLinkMatch.Prefix" class="nav-link"
                                 title="Cuarteles" data-tooltip="Cuarteles">
                            <div class="left">
                                <span class="icon"><i class="fa-solid fa-location-dot"></i></span>
                                @if (!Collapsed)
                                {
                                    <span class="link-text">Cuarteles</span>
                                }
                            </div>
                        </NavLink>
                    </li>
                </ul>
            </div>

             <!-- CALIDAD INSPECIONES / RECLAMOS -->
            <div class="nav-group">
                <span class="nav-title">Reclamos Calidad</span>
                <ul>
                    <li>
                        <NavLink href="/causales" Match="NavLinkMatch.Prefix" class="nav-link"
                                 title="Causales" data-tooltip="Causales">
                            <div class="left">
                                <span class="icon"><i class="fa-solid fa-list-check"></i></span>
                                @if (!Collapsed)
                                {
                                    <span class="link-text">Causales</span>
                                }
                            </div>
                        </NavLink>
                    </li>

                    <li>
                        <NavLink href="/inspecciones" Match="NavLinkMatch.Prefix" class="nav-link"
                                 title="Inspecciones" data-tooltip="Inspecciones">
                            <div class="left">
                                <span class="icon"><i class="fa-solid fa-clipboard-check"></i></span>
                                @if (!Collapsed)
                                {
                                    <span class="link-text">Inspecciones</span>
                                }
                            </div>
                        </NavLink>
                    </li>
                </ul>
            </div>

            <!-- ADMIN -->
            @if (authState.User.IsInRole("Admin"))
            {
                <div class="nav-group">
                    <span class="nav-title">Administración</span>

                    <ul>
                        <li>
                            <NavLink href="/usuarios" Match="NavLinkMatch.Prefix" class="nav-link"
                                     title="Usuarios" data-tooltip="Usuarios">
                                <div class="left">
                                    <span class="icon"><i class="fa-solid fa-users"></i></span>
                                    @if (!Collapsed)
                                    {
                                        <span class="link-text">Usuarios </span>
                                    }
                                </div>
                            </NavLink>
                        </li>

                        <li>
                            <NavLink href="/auditoria" Match="NavLinkMatch.Prefix" class="nav-link"
                                     title="Auditoria" data-tooltip="Auditoria">
                                <div class="left">
                                    <span class="icon"><i class="fa-solid fa-chart-column"></i></span>
                                    @if (!Collapsed)
                                    {
                                    <span class="link-text">Auditoría</span>
                                    }
                                </div>
                            </NavLink>
                        </li>
                    </ul>
                </div>
            }

        </nav>

    </Authorized>

    <NotAuthorized>
        <nav class="nav-section">
            <div class="nav-group">
                <span class="nav-title">Acceso</span>

                <ul>
                    <li>
                        <NavLink href="/login" Match="NavLinkMatch.All" class="nav-link"
                                 title="Login" data-tooltip="Login">
                            <div class="left">
                                <span class="icon"><i class="fa-solid fa-lock"></i></span>
                                @if (!Collapsed)
                                {
                                    <span class="link-text">Login</span>
                                }
                            </div>
                        </NavLink>
                    </li>
                </ul>
            </div>
        </nav>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter] public bool Collapsed { get; set; }
}