@page "/usuarios"
@attribute [Authorize]

@using FrontCodOperacional.Models.Users
@using FrontCodOperacional.Services.Api.Interfaces

@inject IUsersService UsersService
@inject NavigationManager Nav

@implements IDisposable

<div class="page-header">
    <div>
        <div class="page-badge">
            <i class="fa-solid fa-users"></i>
            Usuarios
        </div>

        <h1>
            Administración de Usuarios
        </h1>

        <p>
            Gestión de usuarios, roles y estados de acceso.
        </p>

        <div class="search-box">
            <i class="fa-solid fa-magnifying-glass"></i>
            <input class="search-input"
                   placeholder="Buscar por usuario, nombre o email..."
                   value="@Filtro"
                   @oninput="OnBuscar" />
            @if (IsLoading)
            {
                <i class="fa-solid fa-spinner fa-spin search-loading"></i>
            }
        </div>
    </div>

    <div class="header-actions">
        <button class="primary-btn"
                @onclick="AbrirNuevoUsuario">
            <i class="fa-solid fa-user-plus"></i>
            Nuevo Usuario
        </button>

        <div class="records-card">
            <span class="label">
                Registros
            </span>

            <strong>
                @TotalRecords
            </strong>
        </div>
    </div>
</div>


@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="message-banner">
        <i class="fa-solid fa-circle-info"></i>
        <span>
            @Mensaje
        </span>
    </div>
}

<div class="table-card">
    @if (IsLoading)
    {
        <div class="loading-state">
            <div class="loader"></div>
            <span>
                Cargando usuarios...
            </span>
        </div>
    }
    else
    {
        <div class="table-wrapper">
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>
                            Usuario
                        </th>

                        <th>
                            Nombre
                        </th>

                        <th>
                            Rol
                        </th>

                        <th>
                            Estado
                        </th>

                        <th class="action-column">
                        </th>
                    </tr>
                </thead>

                <tbody>
                    @if (ListaUsuarios.Count == 0)
                    {
                        <tr>
                            <td colspan="5">
                                <div class="empty-state">
                                    <i class="fa-regular fa-folder-open"></i>

                                    <span>
                                        No existen registros.
                                    </span>
                                </div>
                            </td>
                        </tr>
                    }
                    else
                    {
                        @foreach (var usuario in ListaUsuarios)
                        {
                            <tr @onclick="() => AbrirModal(usuario)">
                                <td>
                                    <span class="table-code">
                                        @usuario.Username
                                    </span>
                                </td>


                                <td>
                                    @usuario.Nombre
                                </td>


                                <td>
                                    <span class="code-badge">
                                        @usuario.Role
                                    </span>
                                </td>


                                <td>
                                    @if (usuario.Active)
                                    {
                                        <span class="active-badge">
                                            Activo
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="empty-badge">
                                            Inactivo
                                        </span>
                                    }
                                </td>


                                <td class="row-arrow">
                                    <i class="fa-solid fa-chevron-right"></i>
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        </div>

        <div class="table-footer">
            <button class="pagination-btn"
                    @onclick="Anterior"
                    disabled="@(PageNumber == 1 || IsLoading)">
                <i class="fa-solid fa-chevron-left"></i>
                Anterior
            </button>

            <div class="page-indicator">
                Página
                <strong>
                    @PageNumber
                </strong>
            </div>

            <button class="pagination-btn"
                    @onclick="Siguiente"
                    disabled="@(PageNumber * PageSize >= TotalRecords || IsLoading)">
                Siguiente
                <i class="fa-solid fa-chevron-right"></i>
            </button>
        </div>
    }
</div>

@if (MostrarModal)
{
    <div class="modal-overlay">
        <div class="modern-modal">
            <div class="modal-header">
                <div>
                    <h2>
                        @(EsNuevoUsuario
                            ? "Nuevo Usuario"
                            : "Editar Usuario")
                    </h2>

                    <p>
                        @(EsNuevoUsuario
                            ? "Ingrese la información del nuevo usuario."
                            : "Actualización de información del usuario.")
                    </p>
                </div>

                <button class="close-btn"
                        @onclick="CerrarModal"
                        disabled="@Guardando">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>


            <div class="modal-body">
                @if (EsNuevoUsuario)
                {
                    <div class="form-group">
                        <label>
                            Usuario
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-user"></i>
                            <input class="form-control"
                                   placeholder="Ingrese usuario"
                                   @bind="NuevoUsuario.Username" />
                        </div>
                    </div>


                    <div class="form-group">
                        <label>
                            Nombre
                        </label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-id-card"></i>
                            <input class="form-control"
                                   placeholder="Ingrese nombre"
                                   @bind="NuevoUsuario.Nombre" />
                        </div>
                    </div>


                    <div class="form-group">
                        <label>
                            Email
                        </label>
                        <div class="input-wrapper">
                            <i class="fa-solid fa-envelope"></i>
                            <input class="form-control"
                                   type="email"
                                   placeholder="Ingrese email"
                                   @bind="NuevoUsuario.Email" />
                        </div>
                    </div>


                    <div class="form-group">
                        <label>
                            Contraseña
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-lock"></i>
                            <input class="form-control"
                                   type="password"
                                   placeholder="Ingrese contraseña"
                                   @bind="NuevoUsuario.Password" />
                        </div>
                    </div>


                    <div class="user-role-group">

                        <label class="filter-label">
                            <i class="fa-solid fa-user-shield"></i>
                            Rol
                        </label>

                        <div class="user-role-select-wrapper">

                            <select class="search-input user-role-select"
                                    @bind="NuevoUsuario.Role">

                                @foreach (var role in UserRoles.All)
                                {
                                    <option value="@role">
                                        @role
                                    </option>
                                }

                            </select>

                            <i class="fa-solid fa-chevron-down user-role-select-arrow"></i>

                        </div>

                    </div>
                }
                else if (UsuarioSeleccionado != null)
                {
                    <div class="detail-grid">
                        <div class="detail-item">
                            <span>
                                Usuario
                            </span>

                            <strong>
                                @UsuarioSeleccionado.Username
                            </strong>
                        </div>

                        <div class="detail-item">
                            <span>
                                Estado
                            </span>

                            <strong>
                                @(UsuarioSeleccionado.Active
                                    ? "Activo"
                                    : "Inactivo")
                            </strong>
                        </div>
                    </div>


                    <div class="form-group">
                        <label>
                            Nombre
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-id-card"></i>
                            <input class="form-control"
                                   @bind="UsuarioEditando.Nombre" />

                        </div>
                    </div>


                    <div class="form-group">
                        <label>
                            Email
                        </label>

                        <div class="input-wrapper">
                            <i class="fa-solid fa-envelope"></i>
                            <input class="form-control"
                                   type="email"
                                   @bind="UsuarioEditando.Email" />
                        </div>
                    </div>


                    <div class="user-role-group">

                        <label class="filter-label">
                            <i class="fa-solid fa-user-shield"></i>
                            Rol
                        </label>

                        <div class="user-role-select-wrapper">

                            <select class="search-input user-role-select"
                                    @bind="UsuarioEditando.Role">

                                @foreach (var role in UserRoles.All)
                                {
                                    <option value="@role">
                                        @role
                                    </option>
                                }

                            </select>

                            <i class="fa-solid fa-chevron-down user-role-select-arrow"></i>

                        </div>

                    </div>
                }
            </div>


            <div class="modal-footer">
                <button class="secondary-btn"
                        @onclick="CerrarModal"
                        disabled="@Guardando">
                    Cancelar
                </button>


                @if (!EsNuevoUsuario && UsuarioSeleccionado != null)
                {
                    <button class="secondary-btn"
                            @onclick="CambiarEstado"
                            disabled="@Guardando">

                        @if (UsuarioSeleccionado.Active)
                        {
                            <i class="fa-solid fa-user-slash"></i>
                            <span>Desactivar</span>
                        }
                        else
                        {
                            <i class="fa-solid fa-user-check"></i>
                            <span>Activar</span>
                        }
                    </button>
                }


                <button class="primary-btn"
                        @onclick="(EsNuevoUsuario ? CrearUsuario : ActualizarUsuario)"
                        disabled="@Guardando">
                    @if (Guardando)
                    {
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        <span>Guardando...</span>
                    }
                    else
                    {
                        <i class="fa-solid fa-floppy-disk"></i>

                        <span>
                            @(EsNuevoUsuario
                                ? "Crear Usuario"
                                : "Guardar")
                        </span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code 
{
    private List<UserDto> ListaUsuarios = new();
    private int PageNumber = 1;
    private int PageSize = 10;
    private int TotalRecords = 0;
    private string Filtro = string.Empty;
    private bool IsLoading = false;
    private string? Mensaje;

    private CancellationTokenSource? _searchCts;
    private const int SearchDelay = 300;
    private string _ultimoFiltro = string.Empty;

    private bool MostrarModal = false;
    private bool EsNuevoUsuario = false;
    private bool Guardando = false;

    private UserDto? UsuarioSeleccionado;

    private UpdateUserRequest UsuarioEditando = new();

    private RegisterRequest NuevoUsuario = new()
    {
        Role = "User"
    };

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    public void Dispose()
    {
        _searchCts?.Cancel();
        _searchCts?.Dispose();
    }

    private async Task OnBuscar(ChangeEventArgs e)
    {
        Filtro = e.Value?.ToString() ?? string.Empty;
        PageNumber = 1;
        _searchCts?.Cancel();
        _searchCts?.Dispose();

        _searchCts = new CancellationTokenSource();

        try
        {
            await Task.Delay(SearchDelay, _searchCts.Token);

            if (_ultimoFiltro == Filtro)
                return;

            _ultimoFiltro = Filtro;
            await Cargar(_searchCts.Token);
        }
        catch (TaskCanceledException)
        {

        }
    }


    private async Task Cargar(CancellationToken cancellationToken = default)
    {
        try
        {
            IsLoading = true;
            Mensaje = null;

            var data = await UsersService.GetPaged(
                PageNumber,
                PageSize,
                Filtro,
                cancellationToken);

            if (data != null)
            {
                ListaUsuarios = data.Items;
                TotalRecords = data.TotalRegistros;
            }

        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/login");
        }
        catch
        {
            Mensaje = "Error al cargar usuarios.";
        }
        finally
        {
            IsLoading = false;
        }
    }


    private async Task Siguiente()
    {
        if (PageNumber * PageSize >= TotalRecords)
            return;

        PageNumber++;
        await Cargar();
    }

    private async Task Anterior()
    {
        if (PageNumber == 1)
            return;

        PageNumber--;
        await Cargar();
    }

    private void AbrirModal(UserDto usuario)
    {
        UsuarioSeleccionado = usuario;

        UsuarioEditando = new UpdateUserRequest
        {
            Nombre = usuario.Nombre,
            Email = usuario.Email,
            Role = usuario.Role
        };

        EsNuevoUsuario = false;
        MostrarModal = true;
        Mensaje = null;
    }

    private void AbrirNuevoUsuario()
    {
        UsuarioSeleccionado = null;

        NuevoUsuario = new RegisterRequest
        {
            Role = "User"
        };

        EsNuevoUsuario = true;
        MostrarModal = true;
        Mensaje = null;
    }

    private void CerrarModal()
    {
        MostrarModal = false;

        UsuarioSeleccionado = null;

        EsNuevoUsuario = false;

        Guardando = false;
    }

    private async Task CrearUsuario()
    {
        try
        {
            Guardando = true;
            Mensaje = null;

            await UsersService.Register(NuevoUsuario, CancellationToken.None);

            CerrarModal();

            PageNumber = 1;

            await Cargar();

            Mensaje = "Usuario creado correctamente.";
        }
        catch (Exception ex)
        {
            Mensaje = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task ActualizarUsuario()
    {
        if (UsuarioSeleccionado == null)
            return;

        try
        {
            Guardando = true;
            Mensaje = null;

            await UsersService.Update(
                UsuarioSeleccionado.Id,
                UsuarioEditando,
                CancellationToken.None);

            CerrarModal();

            await Cargar();

            Mensaje = "Usuario actualizado correctamente.";
        }
        catch (Exception ex)
        {
            Mensaje = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }

    private async Task CambiarEstado()
    {
        if (UsuarioSeleccionado == null)
            return;

        try
        {
            Guardando = true;
            Mensaje = null;

            var nuevoEstado = !UsuarioSeleccionado.Active;

            await UsersService.SetStatus(
                UsuarioSeleccionado.Id,
                new SetUserStatusRequest
                {
                    Active = nuevoEstado
                },
                CancellationToken.None);

            CerrarModal();

            await Cargar();

            Mensaje = nuevoEstado
                ? "Usuario activado correctamente."
                : "Usuario desactivado correctamente.";
        }
        catch (Exception ex)
        {
            Mensaje = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }
}