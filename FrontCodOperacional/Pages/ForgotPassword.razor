@page "/forgotpassword"
@using FrontCodOperacional.Services.Api
@using FrontCodOperacional.Models.Auth

@inject AuthApiService AuthApi
@inject NavigationManager Nav

<h3>Recuperar contraseña</h3>

<input @bind="email" placeholder="Correo electrónico" />

<button @onclick="Solicitar">Enviar enlace</button>

<p>@mensaje</p>

@code {
    string email = "";
    string mensaje = "";

    async Task Solicitar()
    {
        var ok = await AuthApi.ForgotPassword(new ForgotPasswordRequest
        {
            Email = email
        });

        if (ok)
        {
            mensaje = "Si el correo existe, se enviará un enlace de recuperación.";
        }
        else
        {
            mensaje = "Error al procesar la solicitud.";
        }
    }
}