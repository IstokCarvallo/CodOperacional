@page "/forgotpassword"

@using FrontCodOperacional.Services.Api
@using FrontCodOperacional.Models.Auth

@inject AuthApiService AuthApi
@inject NavigationManager Nav

<div class="forgot-container">
    <div class="forgot-card">
        <!-- HEADER -->
        <div class="forgot-header">
            <div class="forgot-icon">
                <i class="fa-solid fa-key"></i>
            </div>

            <h1>
                Recuperar contraseña
            </h1>

            <p>
                Ingresa tu correo electrónico y te enviaremos un enlace para restablecer tu contraseña.
            </p>
        </div>

        <!-- FORM -->

        <div class="form-group">
            <label>
                Correo electrónico
            </label>

            <div class="input-wrapper">
                <i class="fa-regular fa-envelope"></i>
                <input type="email"
                       @bind="email"
                       placeholder="correo@empresa.com" />
            </div>
        </div>

        <!-- BUTTON -->

        <button class="submit-btn"
                @onclick="Solicitar"
                disabled="@loading">

            @if (loading)
            {
                <span>
                    <i class="fa-solid fa-spinner fa-spin"></i>
                    Enviando...
                </span>
            }
            else
            {
                <span>
                    <i class="fa-solid fa-paper-plane"></i>
                    Enviar enlace
                </span>
            }

        </button>

        <!-- MESSAGE -->
        @if (!string.IsNullOrWhiteSpace(mensaje))
        {
            <div class="message @(IsSuccess ? "IsSuccess" : "error")">

                <i class="fa-solid @(IsSuccess
                                                       ? "fa-circle-check"
                                                       : "fa-circle-exclamation")"></i>

                <span>@mensaje</span>

            </div>
        }

        <!-- FOOTER -->

        <div class="forgot-footer">

            <button class="back-btn"
                    @onclick="Volver">

                <i class="fa-solid fa-arrow-left"></i>

                Volver al login

            </button>
        </div>
    </div>
</div>

@code {

    private string email = "";
    private string mensaje = "";
    private bool IsSuccess;
    private bool loading;

    private async Task Solicitar()
    {
        mensaje = "";
        loading = true;

        try
        {
            var ok = await AuthApi.ForgotPassword(
                new ForgotPasswordRequest
                {
                    Email = email
                });

            IsSuccess = ok;

            mensaje = ok
                ? "Si el correo existe, se enviará un enlace de recuperación."
                : "Error al procesar la solicitud.";
        }
        finally
        {
            loading = false;
        }
    }

    private void Volver()
    {
        Nav.NavigateTo("/login");
    }
}