@page "/"

@attribute [Authorize]

@inject FrontCodOperacional.Services.UI.ToastService Toast
@inject HttpClient Http

<h3>Pruebas Toast</h3>

<button class="btn btn-success m-1" @onclick="Ok">OK</button>
<button class="btn btn-danger m-1" @onclick="Err">Error manual</button>
<button class="btn btn-warning m-1" @onclick="TestHttp">Error HTTP</button>
<button class="btn btn-dark m-1" @onclick="TestUI">Error UI</button>

@code {
    void Ok() => Toast.Success("Toast OK");

    void Err() => Toast.Error("Toast error");

    // 🔴 PRUEBA 3: Error HTTP (pasa por HttpErrorHandler)
    async Task TestHttp()
    {
        await Http.GetAsync("url-inexistente/test");
    }

    // 🔴 PRUEBA 4: Error UI (pasa por ErrorBoundary)
    void TestUI()
    {
        throw new Exception("Error de prueba UI");
    }
}