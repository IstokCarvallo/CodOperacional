@page "/"
@inject HttpClient Http
@inject AuthenticationStateProvider AuthProvider
@using System.Security.Claims

<h3>Home - Pruebas</h3>

<button class="btn btn-primary" @onclick="CallProtected">
    Endpoint protegido
</button>

<button class="btn btn-warning" @onclick="CallDelayed">
    Test refresh
</button>

<p><b>Resultado:</b> @_result</p>

<hr />

<h5>Claims</h5>

@if (_claims != null)
{
    <ul>
        @foreach (var c in _claims)
        {
            <li>@c.Type : @c.Value</li>
        }
    </ul>
}

@code {
    private string _result = "";
    private IEnumerable<Claim>? _claims;

    protected override async Task OnInitializedAsync()
    {
        var auth = await AuthProvider.GetAuthenticationStateAsync();
        _claims = auth.User.Claims;
    }

    private async Task CallProtected()
    {
        try
        {
            var res = await Http.GetStringAsync("test/protected");
            _result = res;
        }
        catch (Exception ex)
        {
            _result = ex.Message;
        }
    }

    private async Task CallDelayed()
    {
        try
        {
            var res = await Http.GetStringAsync("test/refresh-check");
            _result = res;
        }
        catch (Exception ex)
        {
            _result = ex.Message;
        }
    }
}