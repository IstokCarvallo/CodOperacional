@page "/account/about"

<PageTitle>Acerca de</PageTitle>

<div class="about-page">

    <div class="about-card">

        <div class="about-header">
            <i class="fa-solid fa-circle-info"></i>

            <div>
                <h2>Código Operacional</h2>
                <p>Sistema de Gestión Operacional</p>
            </div>
        </div>

        <div class="about-divider"></div>

        <div class="about-section">

            <div class="about-row">
                <span>Versión Frontend</span>
                <strong>1.0.0</strong>
            </div>

            <div class="about-row">
                <span>Versión API</span>
                <strong>v1</strong>
            </div>

            <div class="about-row">
                <span>Framework</span>
                <strong>.NET 8</strong>
            </div>

            <div class="about-row">
                <span>Interfaz</span>
                <strong>Blazor WebAssembly</strong>
            </div>

            <div class="about-row">
                <span>Base de datos</span>
                <strong>SQL Server 2019</strong>
            </div>

            <div class="about-row">
                <span>Ambiente</span>
                <strong>Producción</strong>
            </div>

        </div>

        <div class="about-divider"></div>

        <div class="about-footer">
            © @DateTime.Now.Year Código Operacional
        </div>

    </div>

</div>