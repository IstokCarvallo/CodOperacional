@page "/account/change-password"

@using FrontCodOperacional.Models.Account
@using FrontCodOperacional.Services.Auth
@using FrontCodOperacional.Services.UI
@using FrontCodOperacional.Components.Forms

@inject IAccountService AccountService
@inject CurrentUserService UserService

<PageTitle>Cambiar contraseña</PageTitle>

<div class="page-container">

    <!-- HEADER -->
    <div class="page-header">
        <div>
            <div class="page-badge">
                <i class="fa-solid fa-shield-halved"></i>
                Seguridad
            </div>

            <h1>Cambiar contraseña</h1>

            <p>
                Actualice su contraseña de acceso al sistema.
            </p>
        </div>
    </div>

    <!-- CARD -->
    <div class="page-card">

        <EditForm Model="_model" OnValidSubmit="HandleSubmitAsync">

            <DataAnnotationsValidator />

            <!-- PASSWORDS -->
            <div class="form-grid">

                <PasswordInput
                    Label="Contraseña actual"
                    @bind-Value="_model.CurrentPassword" />

                <PasswordInput
                    Label="Nueva contraseña"
                    @bind-Value="_model.NewPassword" />

                <PasswordInput
                    Label="Confirmar contraseña"
                    @bind-Value="_confirmPassword" />

            </div>

            <!-- ERROR -->
            @if (!string.IsNullOrWhiteSpace(_error))
            {
                <div class="message error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    @_error
                </div>
            }

            <!-- SUCCESS -->
            @if (!string.IsNullOrWhiteSpace(_success))
            {
                <div class="message success">
                    <i class="fa-solid fa-circle-check"></i>
                    @_success
                </div>
            }

            <!-- ACTIONS -->
            <div class="table-footer">

                <button type="button"
                        class="pagination-btn secondary"
                        @onclick="ResetForm"
                        disabled="@_processing">

                    <i class="fa-solid fa-rotate-left"></i>
                    Limpiar

                </button>

                <button type="submit"
                        class="pagination-btn primary"
                        disabled="@_processing">

                    <i class="fa-solid fa-floppy-disk"></i>

                    @(_processing ? "Procesando..." : "Actualizar contraseña")

                </button>

            </div>

        </EditForm>

    </div>

</div>

@code {

    private ChangePasswordRequest _model = new();

    private string _confirmPassword = string.Empty;

    private bool _processing;

    private string? _error;

    private string? _success;

    private async Task HandleSubmitAsync()
    {
        _error = null;
        _success = null;

        if (_model.NewPassword != _confirmPassword)
        {
            _error = "La confirmación no coincide con la nueva contraseña.";
            return;
        }

        _processing = true;

        try
        {
            _model.UserId = await UserService.GetUserId();

            var result = await AccountService.ChangePasswordAsync(_model);

            if (result)
            {
                _success = "Contraseña actualizada correctamente.";
                ResetForm();
            }
            else
            {
                _error = "No fue posible actualizar la contraseña.";
            }
        }
        finally
        {
            _processing = false;
        }
    }

    private void ResetForm()
    {
        _model = new ChangePasswordRequest();
        _confirmPassword = string.Empty;
        _error = null;
        _success = null;
    }
}