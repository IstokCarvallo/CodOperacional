@page "/cuartel"
@attribute [Authorize]

@using FrontCodOperacional.Models.Cuartel
@using FrontCodOperacional.Services.Api

@inject CuartelesService Service

<PageTitle>Cuarteles | Código Operacional</PageTitle>

<div class="page-container">
    <!-- HEADER -->
    <div class="page-header">
        <div>
            <div class="page-badge">
                <i class="fa-solid fa-location-dot"></i>
                Operación Agrícola
            </div>

            <h1>
                Cuarteles
            </h1>

            <p>
                Asignación y administración de códigos operacionales por productor y predio.
            </p>
        </div>

        <div class="records-card">
            <span class="label">
                Registros
            </span>

            <strong>
                @Cuarteles.Count
            </strong>
        </div>
    </div>

    <!-- ALERT -->
    @if (!string.IsNullOrWhiteSpace(Mensaje))    {
        <div class="message-banner">
            <i class="fa-solid fa-circle-info"></i>
            <span>@Mensaje</span>
        </div>
    }

    <!-- FILTERS -->
    <div class="filters-card">
        <div class="filters-grid">
            <div class="filter-group">
                <label>
                    Productor
                </label>

                <SearchSelect TItem="ProductorDto"
                              Placeholder="Buscar productor..."
                              SearchMethod="BuscarProductores"
                              ItemText="@(p => $"{p.Codigo} - {p.Nombre}")"
                              OnSelected="OnProductorSeleccionado" />

            </div>

            @if (ProductorSeleccionado.HasValue)
            {
                <div class="filter-group">
                    <label>
                        Predio
                    </label>
                    <SearchSelect TItem="PredioDto"
                                  Placeholder="Buscar predio..."
                                  SearchMethod="BuscarPredios"
                                  ItemText="@(p => $"{p.Codigo} - {p.Nombre}")"
                                  OnSelected="OnPredioSeleccionado" />

                </div>
            }
        </div>
    </div>

    <!-- TABLE -->
    @if (Cuarteles.Any())
    {
        <div class="table-card">
            <div class="table-wrapper">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Código Operacional</th>
                            <th>Última Actualización</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var c in Cuarteles)
                        {
                            <tr @onclick="() => AbrirModal(c)">
                                <td>
                                    <span class="table-code">
                                        @c.CodigoCuartel
                                    </span>
                                </td>

                                <td>
                                    @c.Nombre
                                </td>

                                <td>
                                    @if (string.IsNullOrWhiteSpace(c.CodigoOperacional))
                                    {
                                        <span class="empty-badge">
                                            Sin asignar
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="code-badge">
                                            @c.CodigoOperacional
                                        </span>
                                    }
                                </td>

                                <td>
                                    @(c.FechaUltimaActualizacion?.ToString("dd-MM-yyyy HH:mm")
                                        ?? "-")
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else if (PredioSeleccionado.HasValue)
    {
        <div class="empty-card">
            <i class="fa-regular fa-folder-open"></i>
            <h3>
                Sin resultados
            </h3>

            <p>
                No existen cuarteles asociados al predio seleccionado.
            </p>
        </div>
    }
</div>

<!-- MODAL -->
@if (MostrarModal && CuartelSeleccionado != null)
{
    <div class="modal-overlay">
        <div class="modern-modal">

            <!-- HEADER -->
            <div class="modal-header">
                <div>
                    <h2>
                        Actualizar Cuartel
                    </h2>

                    <p>
                        @CuartelSeleccionado.Nombre
                    </p>
                </div>

                <button class="close-btn" @onclick="CerrarModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <div class="detail-card">
                    <span>
                        Código Cuartel
                    </span>

                    <strong>
                        @CuartelSeleccionado.CodigoCuartel
                    </strong>
                </div>

                <div class="form-group">
                    <label>
                        Código Operacional
                    </label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-barcode"></i>
                        <input placeholder="Código operacional"
                               value="@CodigoOperacional"
                               @oninput="OnCodigoChange" />
                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="secondary-btn" @onclick="CerrarModal">
                    Cancelar
                </button>

                <button class="primary-btn"
                        @onclick="Guardar"
                        disabled="@Guardando">

                    @if (Guardando)
                    {
                        <span>
                            <i class="fa-solid fa-spinner fa-spin"></i>
                            Guardando...
                        </span>
                    }
                    else
                    {
                        <span>
                            <i class="fa-solid fa-floppy-disk"></i>
                            Guardar
                        </span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    List<CuartelDto> Cuarteles = new();

    int? ProductorSeleccionado;
    int? PredioSeleccionado;

    CuartelDto? CuartelSeleccionado;

    private string? Mensaje;
    private bool Guardando = false;
    string CodigoOperacional = "";
    bool MostrarModal = false;

    private async Task<List<ProductorDto>> BuscarProductores(string filtro)
    {
        return await Service.GetProductores(
            CancellationToken.None,
            filtro);
    }

    private async Task OnProductorSeleccionado(ProductorDto p)
    {
        ProductorSeleccionado = p.Codigo;
        PredioSeleccionado = null;
        Cuarteles.Clear();
    }

    private async Task<List<PredioDto>> BuscarPredios(string filtro)
    {
        if (!ProductorSeleccionado.HasValue)
            return new();

        return await Service.GetPredios(
            ProductorSeleccionado.Value,
            CancellationToken.None,
            filtro);
    }

    private async Task OnPredioSeleccionado(PredioDto p)
    {
        PredioSeleccionado = p.Codigo;

        if (ProductorSeleccionado.HasValue)
        {
            Cuarteles = await Service.GetCuarteles(
                ProductorSeleccionado.Value,
                p.Codigo,
                CancellationToken.None);
        }
    }

    void AbrirModal(CuartelDto cuartel)
    {
        CuartelSeleccionado = cuartel;
        CodigoOperacional = cuartel.CodigoOperacional ?? "";
        MostrarModal = true;
    }

    void CerrarModal()
    {
        MostrarModal = false;
        CuartelSeleccionado = null;
    }

    void OnCodigoChange(ChangeEventArgs e)
    {
        CodigoOperacional = e.Value?.ToString()?.ToUpper() ?? "";
    }

    async Task Guardar()
    {
        if (CuartelSeleccionado == null
            || ProductorSeleccionado == null
            || PredioSeleccionado == null)
            return;

        if (string.IsNullOrWhiteSpace(CodigoOperacional))
        {
            Mensaje = "Debe ingresar un valor.";
            return;
        }

        try
        {
            Guardando = true;
            Mensaje = null;

            var dto = new UpdateCodigoOperacionalDto
            {
                Productor = ProductorSeleccionado.Value,
                Predio = PredioSeleccionado.Value,
                CodigoCuartel = CuartelSeleccionado.CodigoCuartel,
                CodigoOperacional = CodigoOperacional
            };

            await Service.UpdateCodigoOperacional(
                dto,
                CancellationToken.None);

            Cuarteles = await Service.GetCuarteles(
                ProductorSeleccionado.Value,
                PredioSeleccionado.Value,
                CancellationToken.None);

            CerrarModal();

            Mensaje = "Actualización correcta.";
        }
        catch (Exception ex)
        {
            Mensaje = ex.Message;
        }
        finally
        {
            Guardando = false;
        }
    }
}