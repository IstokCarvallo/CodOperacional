@page "/resetpassword"
@using Microsoft.AspNetCore.WebUtilities
@using FrontCodOperacional.Services.Api
@using FrontCodOperacional.Models.Auth

@inject NavigationManager Nav
@inject AuthApiService AuthApi

<h3>Restablecer contraseña</h3>

@if (!string.IsNullOrEmpty(errorToken))
{
    <p style="color:red">@errorToken</p>
}
else
{
    <input @bind="password" type="password" placeholder="Nueva contraseña" />
    <input @bind="confirm" type="password" placeholder="Confirmar contraseña" />

    <button @onclick="Reset">Actualizar contraseña</button>

    <p>@mensaje</p>
}

@code {
    string token = "";
    string password = "";
    string confirm = "";
    string mensaje = "";
    string errorToken = "";

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("token", out var t))
        {
            errorToken = "Token inválido.";
            return;
        }

        token = t!;
    }

    async Task Reset()
    {
        if (password != confirm)
        {
            mensaje = "Las contraseñas no coinciden.";
            return;
        }

        var ok = await AuthApi.ResetPassword(new ResetPasswordRequest
        {
            Token = token,
            NewPassword = password
        });

        if (ok)
        {
            mensaje = "Contraseña actualizada correctamente.";
            await Task.Delay(1500);
            Nav.NavigateTo("/login");
        }
        else
        {
            mensaje = "Token inválido o expirado.";
        }
    }
}