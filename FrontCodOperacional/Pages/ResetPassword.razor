@page "/resetpassword"

@using Microsoft.AspNetCore.WebUtilities
@using FrontCodOperacional.Services.Api
@using FrontCodOperacional.Models.Auth

@inject NavigationManager Nav
@inject AuthApiService AuthApi

<div class="reset-container">
    <div class="reset-card">
        <!-- HEADER -->
        <div class="reset-header">
            <div class="reset-icon">
                <i class="fa-solid fa-shield-keyhole"></i>
            </div>

            <h1>
                Restablecer contraseña
            </h1>

            <p>
                Ingresa una nueva contraseña segura para recuperar el acceso a tu cuenta.
            </p>
        </div>

        <!-- TOKEN ERROR -->
        @if (!string.IsNullOrEmpty(errorToken))
        {
            <div class="message error">
                <i class="fa-solid fa-circle-exclamation"></i>
                <span>@errorToken</span>
            </div>

            <div class="reset-footer">
                <button class="back-btn" @onclick="VolverLogin">
                    <i class="fa-solid fa-arrow-left"></i>

                    Volver al login
                </button>
            </div>
        }
        else
        {
            <!-- PASSWORD -->
            <div class="form-group">
                <label>
                    Nueva contraseña
                </label>

                <div class="input-wrapper">
                    <i class="fa-solid fa-lock"></i>
                    <input type="password"
                           @bind="password"
                           placeholder="Nueva contraseña" />
                </div>
            </div>

            <!-- CONFIRM -->

            <div class="form-group">
                <label>
                    Confirmar contraseña
                </label>

                <div class="input-wrapper">
                    <i class="fa-solid fa-lock"></i>

                    <input type="password"
                           @bind="confirm"
                           placeholder="Confirmar contraseña" />
                </div>
            </div>

            <!-- BUTTON -->

            <button class="submit-btn"
                    @onclick="Reset"
                    disabled="@loading">

                @if (loading)
                {
                    <span>
                        <i class="fa-solid fa-spinner fa-spin"></i>
                        Actualizando...
                    </span>
                }
                else
                {
                    <span>
                        <i class="fa-solid fa-key"></i>
                        Actualizar contraseña
                    </span>
                }
            </button>

            <!-- MESSAGE -->
            @if (!string.IsNullOrWhiteSpace(mensaje))
            {
                <div class="message @(success ? "success" : "error")">

                    <i class="fa-solid @(success
                            ? "fa-circle-check"
                            : "fa-circle-exclamation")"></i>

                    <span>@mensaje</span>
                </div>
            }

            <!-- FOOTER -->

            <div class="reset-footer">
                <button class="back-btn"
                        @onclick="VolverLogin">

                    <i class="fa-solid fa-arrow-left"></i>

                    Volver al login

                </button>
            </div>
        }
    </div>
</div>

@code {

    private string token = "";
    private string password = "";
    private string confirm = "";
    private string mensaje = "";
    private string errorToken = "";
    private bool loading;
    private bool success;

    protected override void OnInitialized()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);

        var query = QueryHelpers.ParseQuery(uri.Query);

        if (!query.TryGetValue("token", out var t))
        {
            errorToken = "El enlace de recuperación es inválido.";
            return;
        }

        token = t!;
    }

    private async Task Reset()
    {
        mensaje = "";

        if (string.IsNullOrWhiteSpace(password))
        {
            mensaje = "Debes ingresar una contraseña.";
            success = false;
            return;
        }

        if (password != confirm)
        {
            mensaje = "Las contraseñas no coinciden.";
            success = false;
            return;
        }

        loading = true;

        try
        {
            var ok = await AuthApi.ResetPassword(
                new ResetPasswordRequest
                {
                    Token = token,
                    NewPassword = password
                });

            success = ok;

            mensaje = ok
                ? "Contraseña actualizada correctamente."
                : "El token es inválido o expiró.";

            if (ok)
            {
                await Task.Delay(1800);

                Nav.NavigateTo("/login");
            }
        }
        finally
        {
            loading = false;
        }
    }

    private void VolverLogin()
    {
        Nav.NavigateTo("/login");
    }
}