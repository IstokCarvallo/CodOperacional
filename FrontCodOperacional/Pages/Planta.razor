@page "/planta"
@attribute [Authorize]

@using FrontCodOperacional.Models.Planta
@using FrontCodOperacional.Services.Api

@inject PlantasService PlantasService
@inject NavigationManager Nav

<PageTitle>Plantas | Código Operacional</PageTitle>

<div class="page-container">
    <!-- HEADER -->
    <div class="page-header">
        <div>
            <div class="page-badge">
                <i class="fa-solid fa-industry"></i>
                Operación
            </div>

            <h1>
                Plantas / Packing
            </h1>

            <p>
                Administración y asignación de códigos operacionales.
            </p>
        </div>

        <div class="header-actions">
            <div class="records-card">
                <span class="label">
                    Registros
                </span>

                <strong>
                    @TotalRecords
                </strong>
            </div>
        </div>
    </div>

    <!-- ALERT -->
    @if (!string.IsNullOrWhiteSpace(Mensaje))
    {
        <div class="message-banner">
            <i class="fa-solid fa-circle-info"></i>
            <span>@Mensaje</span>
        </div>
    }

    <!-- TABLE CARD -->
    <div class="table-card">
        <!-- LOADING -->
        @if (IsLoading)
        {
            <div class="loading-state">
                <div class="loader"></div>
                <span>Cargando información...</span>
            </div>
        }
        else
        {
            <!-- TABLE -->
            <div class="table-wrapper">
                <table class="modern-table">
                    <thead>
                        <tr>
                            <th>Código</th>
                            <th>Nombre</th>
                            <th>Cod. Operacional</th>
                            <th>Última actualización</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (Plantas.Count == 0)
                        {
                            <tr>
                                <td colspan="4">
                                    <div class="empty-state">
                                        <i class="fa-regular fa-folder-open"></i>
                                        <span>
                                            No existen registros.
                                        </span>
                                    </div>
                                </td>
                            </tr>
                        }
                        else
                        {
                            @foreach (var p in Plantas)
                            {
                                <tr @onclick="() => AbrirModal(p)">
                                    <td>
                                        <span class="table-code">
                                            @p.Codigo
                                        </span>
                                    </td>

                                    <td>
                                        @p.Nombre
                                    </td>

                                    <td>

                                        @if (string.IsNullOrWhiteSpace(p.CodigoOperacional))
                                        {
                                            <span class="empty-badge">
                                                Sin asignar
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="code-badge">
                                                @p.CodigoOperacional
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        @(p.FechaUltimaActualizacion.HasValue
                                            ? p.FechaUltimaActualizacion.Value.ToString("dd-MM-yyyy HH:mm")
                                            : "-")

                                    </td>
                                </tr>
                            }
                        }
                    </tbody>
                </table>
            </div>

            <!-- FOOTER -->
            <div class="table-footer">
                <button class="pagination-btn"
                        @onclick="Anterior"
                        disabled="@(PageNumber == 1 || IsLoading)">

                    <i class="fa-solid fa-chevron-left"></i>
                    Anterior
                </button>

                <div class="page-indicator">
                    Página
                    <strong>@PageNumber</strong>
                </div>

                <button class="pagination-btn"
                        @onclick="Siguiente"
                        disabled="@(PageNumber * PageSize >= TotalRecords || IsLoading)">
                    Siguiente
                    <i class="fa-solid fa-chevron-right"></i>
                </button>
            </div>
        }
    </div>
</div>

<!-- MODAL -->
@if (MostrarModal && PlantaSeleccionada != null){
    <div class="modal-overlay">
        <div class="modern-modal">
            <!-- HEADER -->
            <div class="modal-header">
                <div>
                    <h2>
                        Código Operacional
                    </h2>

                    <p>
                        Actualización de planta operacional.
                    </p>
                </div>

                <button class="close-btn" @onclick="CerrarModal">
                    <i class="fa-solid fa-xmark"></i>
                </button>
            </div>

            <!-- BODY -->
            <div class="modal-body">
                <div class="detail-grid">
                    <div class="detail-item">
                        <span>Código</span>
                        <strong>
                            @PlantaSeleccionada.Codigo
                        </strong>
                    </div>

                    <div class="detail-item">
                        <span>Nombre</span>
                        <strong>
                            @PlantaSeleccionada.Nombre
                        </strong>
                    </div>
                </div>
                <div class="detail-date">
                    <span>
                        Última actualización:
                    </span>
                    <strong>
                        @(PlantaSeleccionada.FechaUltimaActualizacion.HasValue
                            ? PlantaSeleccionada.FechaUltimaActualizacion.Value.ToString("dd-MM-yyyy HH:mm")
                            : "Sin registro")
                    </strong>
                </div>

                <div class="form-group">
                    <label>
                        Código operacional
                    </label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-barcode"></i>
                        <input placeholder="Ingrese código operacional"
                               value="@CodigoOperacionalInput"
                               @oninput="OnCodigoChange" />

                    </div>
                </div>
            </div>

            <!-- FOOTER -->
            <div class="modal-footer">
                <button class="secondary-btn"
                        @onclick="CerrarModal"
                        disabled="@Guardando">
                    Cancelar
                </button>

                <button class="primary-btn"
                        @onclick="GuardarCodigo"
                        disabled="@Guardando">
                    @if (Guardando)
                    {
                        <span>
                            <i class="fa-solid fa-spinner fa-spin"></i>
                            Guardando...
                        </span>
                    }
                    else
                    {
                        <span>
                            <i class="fa-solid fa-floppy-disk"></i>
                            Guardar
                        </span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private List<PlantaDto> Plantas = new();
    private PlantaDto? PlantaSeleccionada;

    private int PageNumber = 1;
    private int PageSize = 10;
    private int TotalRecords = 0;

    private bool IsLoading = false;

    private bool MostrarModal = false;
    private string CodigoOperacionalInput = string.Empty;

    private string? Mensaje;
    private bool Guardando = false;

    private void OnCodigoChange(ChangeEventArgs e)
    {
        CodigoOperacionalInput = e.Value?.ToString()?.ToUpper() ?? string.Empty;
    }

    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    private async Task Cargar()
    {
        try
        {
            IsLoading = true;
            Mensaje = null;

            var data = await PlantasService.GetPaged(
                PageNumber,
                PageSize,
                CancellationToken.None);

            if (data != null)
            {
                Plantas = data.Items;
                TotalRecords = data.TotalRegistros;
            }
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/login");
        }
        catch
        {
            Mensaje = "Error al cargar datos.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Siguiente()
    {
        if (PageNumber * PageSize >= TotalRecords)
            return;

        PageNumber++;

        await Cargar();
    }

    private async Task Anterior()
    {
        if (PageNumber == 1)
            return;

        PageNumber--;

        await Cargar();
    }

    private void AbrirModal(PlantaDto planta)
    {
        PlantaSeleccionada = planta;

        CodigoOperacionalInput =
            planta.CodigoOperacional ?? string.Empty;

        MostrarModal = true;

        Mensaje = null;
    }

    private void CerrarModal()
    {
        MostrarModal = false;

        PlantaSeleccionada = null;

        CodigoOperacionalInput = string.Empty;
    }

    private async Task GuardarCodigo()
    {
        if (PlantaSeleccionada == null)
            return;

        if (string.IsNullOrWhiteSpace(CodigoOperacionalInput))
        {
            Mensaje = "Debe ingresar un valor.";
            return;
        }

        try
        {
            Guardando = true;

            Mensaje = null;

            await PlantasService.ActualizarCodigo(
                new ActualizarCodigoOperacionalRequest
                {
                    Codigo = PlantaSeleccionada.Codigo,
                    CodigoOperacional = CodigoOperacionalInput
                },
                CancellationToken.None);

            CerrarModal();

            await Cargar();

            Mensaje = "Actualización correcta.";
        }
        catch (Exception ex)
        {
            Mensaje = ex.Message;

            Nav.NavigateTo("/login");
        }
        finally
        {
            Guardando = false;
        }
    }
}