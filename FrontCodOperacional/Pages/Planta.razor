@page "/planta"
@attribute [Authorize]

@using System.Net
@using System.Net.Http.Json
@using FrontCodOperacional.Models.Planta
@using FrontCodOperacional.Services.Api

@inject PlantasService PlantasService
@inject NavigationManager Nav

<h3>Asignar Código Operacional</h3>

@if (!string.IsNullOrWhiteSpace(Mensaje))
{
    <div class="alert alert-info mt-2">@Mensaje</div>
}

<!-- Listado -->
@if (IsLoading)
{
    <p>Cargando...</p>
}
else
{
    <table class="table table-hover">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Cod. Operacional</th>
                <th>F. Actualización</th>
                <th style="width:160px;"></th>
            </tr>
        </thead>
        <tbody>
            @if (Plantas.Count == 0)
            {
                <tr><td colspan="4">Sin resultados</td></tr>
            }
            else
            {
                @foreach (var p in Plantas)
                {
                    <tr>
                        <td>@p.Codigo</td>
                        <td>@p.Nombre</td>
                        <td>@p.CodigoOperacional</td>
                        <td>
                            @(p.FechaUltimaActualizacion.HasValue
                                ? p.FechaUltimaActualizacion.Value.ToString("dd-MM-yyyy HH:mm")
                                : "-")
                        </td>
                        <td>
                            <button class="btn btn-success btn-sm"
                                    @onclick="() => AbrirModal(p)">
                                Asignar
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Paginación -->
    <div class="d-flex justify-content-between">
        <button class="btn btn-secondary"
                @onclick="Anterior"
                disabled="@(PageNumber == 1 || IsLoading)">
            Anterior
        </button>

        <span>Página @PageNumber</span>

        <button class="btn btn-secondary"
                @onclick="Siguiente"
                disabled="@(PageNumber * PageSize >= TotalRecords || IsLoading)">
            Siguiente
        </button>
    </div>
}

<!-- Modal -->
@if (MostrarModal && PlantaSeleccionada != null)
{
    <div class="modal fade show d-block" style="background-color:rgba(0,0,0,0.5)">
        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title">Asignar Código Operacional</h5>
                    <button class="btn-close" @onclick="CerrarModal"></button>
                </div>

                <div class="modal-body">
                    <div><strong>Código:</strong> @PlantaSeleccionada.Codigo</div>
                    <div><strong>Nombre:</strong> @PlantaSeleccionada.Nombre</div>
                    <div class="mt-2">
                        <strong>Última actualización:</strong>
                        @(PlantaSeleccionada.FechaUltimaActualizacion.HasValue
                            ? PlantaSeleccionada.FechaUltimaActualizacion.Value.ToString("dd-MM-yyyy HH:mm")
                            : "Sin registro")
                    </div>

                    <input class="form-control mt-3"
                           placeholder="Ingrese código operacional"
                           @bind="CodigoOperacionalInput" />
                </div>

                <div class="modal-footer">
                    <button class="btn btn-secondary"
                            @onclick="CerrarModal"
                            disabled="@Guardando">
                        Cancelar
                    </button>

                    <button class="btn btn-success"
                            @onclick="GuardarCodigo"
                            disabled="@Guardando">

                        @if (Guardando)
                        {
                            <span class="spinner-border spinner-border-sm"></span>
                        }
                        else
                        {
                            <span>Guardar</span>
                        }
                    </button>
                </div>

            </div>
        </div>
    </div>
}

@code {
    // =========================
    // ESTADO UI
    // =========================
    private List<PlantaDto> Plantas = new();
    private PlantaDto? PlantaSeleccionada;

    private int PageNumber = 1;
    private int PageSize = 10;
    private int TotalRecords = 0;

    private bool IsLoading = false;

    private bool MostrarModal = false;
    private string CodigoOperacionalInput = string.Empty;

    private string? Mensaje;
    private bool Guardando = false;

    // =========================
    // CICLO VIDA
    // =========================
    protected override async Task OnInitializedAsync()
    {
        await Cargar();
    }

    // =========================
    // LISTADO
    // =========================
    private async Task Cargar()
    {
        try
        {
            IsLoading = true;
            Mensaje = null;

            var data = await PlantasService.GetPaged(PageNumber, PageSize);

            if (data != null)
            {
                Plantas = data.Items;
                TotalRecords = data.TotalRegistros;
            }
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/login");
        }
        catch
        {
            Mensaje = "Error al cargar datos.";
        }
        finally
        {
            IsLoading = false;
        }
    }

    private async Task Siguiente()
    {
        if (PageNumber * PageSize >= TotalRecords)
            return;

        PageNumber++;
        await Cargar();
    }

    private async Task Anterior()
    {
        if (PageNumber == 1)
            return;

        PageNumber--;
        await Cargar();
    }

    // =========================
    // MODAL
    // =========================
    private void AbrirModal(PlantaDto planta)
    {
        PlantaSeleccionada = planta;
        CodigoOperacionalInput = planta.CodigoOperacional ?? string.Empty;
        MostrarModal = true;
        Mensaje = null;
    }

    private void CerrarModal()
    {
        MostrarModal = false;
        PlantaSeleccionada = null;
        CodigoOperacionalInput = string.Empty;
    }

    // =========================
    // GUARDADO
    // =========================
    private async Task GuardarCodigo()
    {
        if (PlantaSeleccionada == null)
            return;

        if (string.IsNullOrWhiteSpace(CodigoOperacionalInput))
        {
            Mensaje = "Debe ingresar un valor.";
            return;
        }

        try
        {
            Guardando = true;
            Mensaje = null;

            var ok = await PlantasService.ActualizarCodigo(
                new ActualizarCodigoOperacionalRequest
                {
                    Codigo = PlantaSeleccionada.Codigo,
                    CodigoOperacional = CodigoOperacionalInput
                });

            if (ok)
            {
                CerrarModal();
                await Cargar();
                Mensaje = "Actualización correcta.";
            }
            else
            {
                Mensaje = "Error al actualizar.";
            }
        }
        catch (UnauthorizedAccessException)
        {
            Nav.NavigateTo("/login");
        }
        finally
        {
            Guardando = false;
        }
    }
}