<UserControl x:Class="DesktopCodOperacional.Controls.OperationalLoadingOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Panel.ZIndex="99"
            Background="#66FFFFFF"
            IsHitTestVisible="False"
            Visibility="{Binding IsBusy,
            Converter={StaticResource BoolToVisibilityConverter}}">

        <Grid>
            <Border Width="260"
                    Padding="24"
                    Background="White"
                    CornerRadius="18"
                    BorderBrush="#E2E8F0"
                    BorderThickness="1"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">

                <StackPanel>
                    <ProgressBar Height="6"
                                 IsIndeterminate="True"
                                 Margin="0,0,0,18"/>

                    <TextBlock Text="Procesando información"
                               FontSize="16"
                               FontWeight="SemiBold"
                               Foreground="#0F172A"
                               HorizontalAlignment="Center"/>

                    <TextBlock Text="Espere un momento..."
                               Margin="0,6,0,0"
                               FontSize="13"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"/>

                </StackPanel>
            </Border>
        </Grid>
    </Border>
</UserControl>