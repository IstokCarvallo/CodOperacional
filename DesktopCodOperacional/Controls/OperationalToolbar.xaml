<UserControl x:Class="DesktopCodOperacional.Controls.OperationalToolbar"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Height="88">

    <Border Background="White"
            CornerRadius="18"
            Padding="18,12,18,12"
            MinHeight="54"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            VerticalAlignment="Center">

        <Grid>

            <Grid.ColumnDefinitions>

                <ColumnDefinition Width="320"/>
                <ColumnDefinition Width="*"/>

                <ColumnDefinition Width="110"/>

                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>

            </Grid.ColumnDefinitions>

            <!-- SEARCH -->
            <Border Height="42"
                    Background="#F8FAFC"
                    CornerRadius="12">

                <Grid Margin="14,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Text="&#xE721;"
                               FontFamily="Segoe MDL2 Assets"
                               Foreground="#64748B"
                               VerticalAlignment="Center"/>

                    <TextBox Grid.Column="1"
                             Margin="10,0,0,0"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             FontSize="13"
                             Text="{Binding SearchText,
                             UpdateSourceTrigger=PropertyChanged}"/>
                </Grid>
            </Border>

            <!-- LOADING -->
            <Grid Grid.Column="2"
                  VerticalAlignment="Center"
                  HorizontalAlignment="Center"
                  Visibility="{Binding IsBusy,
                                Converter={StaticResource BoolToVisibilityConverter}}">

                <StackPanel>
                    <ProgressBar Width="70"
                                 Height="4"
                                 IsIndeterminate="True"/>

                    <TextBlock Text="Procesando..."
                               FontSize="11"
                               Foreground="#64748B"
                               HorizontalAlignment="Center"
                               Margin="0,6,0,0"/>
                </StackPanel>
            </Grid>

            <!-- REFRESH -->
            <Button Grid.Column="3"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding RefreshCommand}"
                    Visibility="{Binding ShowRefresh}">

                <TextBlock Text="&#xE72C;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"
                           VerticalAlignment="Center"/>

            </Button>

            <!-- FILTER -->
            <Button Grid.Column="4"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding FilterCommand}"
                    Visibility="{Binding ShowFilter}">

                <TextBlock Text="&#xE71C;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>
            </Button>

            <!-- EXCEL -->
            <Button Grid.Column="5"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding ExcelCommand}"
                    Visibility="{Binding ShowExcel}">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="&#xE9F9;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="Excel"/>
                </StackPanel>
            </Button>

            <!-- PDF -->
            <Button Grid.Column="6"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding PdfCommand}"
                    Visibility="{Binding ShowPdf}">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="&#xEA90;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="PDF"/>
                </StackPanel>
            </Button>

            <!-- PRINT -->
            <Button Grid.Column="7"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding PrintCommand}"
                    Visibility="{Binding ShowPrint}">

                <TextBlock Text="&#xE749;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="14"/>

            </Button>

            <!-- FOLDER -->
            <Button Grid.Column="8"
                    Style="{StaticResource ToolbarButtonStyle}"
                    Command="{Binding OpenFolderCommand}"
                    Visibility="{Binding ShowFolder}">

                <StackPanel Orientation="Horizontal">

                    <TextBlock Text="&#xE838;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               Margin="0,0,8,0"/>

                    <TextBlock Text="Exportaciones"/>
                </StackPanel>
            </Button>

            <!-- ACTION -->
            <Button Grid.Column="9"
                    Margin="12,0,0,0"
                    Padding="18,0"
                    Height="42"
                    Background="#2563EB"
                    BorderThickness="0"
                    Foreground="White"
                    FontWeight="SemiBold"
                    Command="{Binding ActionCommand}"
                    Visibility="{Binding ShowAction}">

                <TextBlock Text="{Binding ActionText}"/>
            </Button>
        </Grid>
    </Border>
</UserControl>