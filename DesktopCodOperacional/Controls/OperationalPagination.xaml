<UserControl x:Class="DesktopCodOperacional.Controls.OperationalPagination"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Border Padding="14"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="14">

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center">

                <!-- INFO -->
                <TextBlock Text="Página"
                           VerticalAlignment="Center"
                           Margin="0,0,10,0"
                           Foreground="#64748B"
                           FontWeight="SemiBold"/>

                <!-- ACTUAL -->
                <Border Width="36"
                        Height="36"
                        Background="#EFF6FF"
                        CornerRadius="8"
                        VerticalAlignment="Center">

                    <TextBlock Text="{Binding PaginaActual}"
                               FontWeight="Bold"
                               FontSize="14"
                               Foreground="#2563EB"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               TextAlignment="Center"/>
                </Border>

                <TextBlock Text="/"
                           Margin="10,0"
                           VerticalAlignment="Center"
                           Foreground="#94A3B8"/>

                <!-- TOTAL -->
                <TextBlock Text="{Binding TotalPaginas}"
                           VerticalAlignment="Center"
                           FontWeight="SemiBold"
                           Foreground="#334155"/>

                <!-- BOTONES -->
                <StackPanel Orientation="Horizontal"
                            Margin="20,0,0,0">

                    <Button Content="Anterior"
                            Width="110"
                            Height="38"
                            Margin="0,0,10,0"
                            Command="{Binding PaginaAnteriorCommand}"
                            IsEnabled="{Binding IsBusy,
                            Converter={StaticResource InverseBoolConverter}}"/>

                    <Button Content="Siguiente"
                            Width="110"
                            Height="38"
                            Command="{Binding SiguientePaginaCommand}"
                            IsEnabled="{Binding IsBusy,
                            Converter={StaticResource InverseBoolConverter}}"/>

                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>