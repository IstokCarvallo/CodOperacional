<UserControl x:Class="DesktopCodOperacional.Controls.OperationalFilters"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Border Padding="18"
            Background="#F8FAFC"
            BorderBrush="#E2E8F0"
            BorderThickness="1"
            CornerRadius="14"
            Visibility="{Binding FiltersVisible,
            Converter={StaticResource BoolToVisibilityConverter}}">

        <StackPanel>
            <!-- HEADER -->
            <DockPanel Margin="0,0,0,16">
                <TextBlock Text="Filtros avanzados"
                           FontSize="15"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"
                           VerticalAlignment="Center"
                           DockPanel.Dock="Left"/>

                <Button Width="110"
                        Height="38"
                        HorizontalAlignment="Right"
                        Background="#2563EB"
                        Foreground="White"
                        BorderThickness="0"
                        FontWeight="SemiBold"
                        Cursor="Hand"
                        DockPanel.Dock="Right"
                        Command="{Binding ClearFiltersCommand}">

                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Center">

                        <TextBlock Text="&#xE894;"
                                   FontFamily="Segoe MDL2 Assets"
                                   Margin="0,0,8,0"
                                   VerticalAlignment="Center"/>

                        <TextBlock Text="Limpiar"
                                    VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <!-- FILTERS -->
            <ItemsControl ItemsSource="{Binding Filters}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="240"
                                    Margin="0,0,16,0">

                            <TextBlock Text="{Binding Label}"
                                       Margin="0,0,0,6"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="#334155"/>

                            <Border MinHeight="42"
                                    Background="White"
                                    BorderBrush="#CBD5E1"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,0">

                                <TextBox BorderThickness="0"
                                         Background="Transparent"
                                         VerticalContentAlignment="Center"
                                         FontSize="13"
                                         Text="{Binding Value,
                                         UpdateSourceTrigger=PropertyChanged}"/>

                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Border>
</UserControl>