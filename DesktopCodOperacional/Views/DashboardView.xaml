<UserControl x:Class="DesktopCodOperacional.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:DesktopCodOperacional.Views">

    <Grid Margin="20">

        <StackPanel>

            <TextBlock Text="Dashboard"
                       FontSize="32"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <UniformGrid Columns="3">

                <Border Height="140"
                        Margin="10"
                        CornerRadius="12"
                        Background="White">

                    <Grid>
                        <TextBlock Text="Cuarteles"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                </Border>

                <Border Height="140"
                        Margin="10"
                        CornerRadius="12"
                        Background="White">

                    <Grid>
                        <TextBlock Text="Plantas"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                </Border>

                <Border Height="140"
                        Margin="10"
                        CornerRadius="12"
                        Background="White">

                    <Grid>
                        <TextBlock Text="Usuarios"
                                   FontSize="24"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"/>
                    </Grid>

                </Border>

            </UniformGrid>

        </StackPanel>

    </Grid>
</UserControl>
