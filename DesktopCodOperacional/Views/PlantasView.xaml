<UserControl x:Class="DesktopCodOperacional.Views.PlantasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopCodOperacional.Controls">

    <Grid Margin="20">

        <Border Padding="20"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOOLBAR -->
                <controls:OperationalToolbar Grid.Row="1"
                                             Margin="0,0,0,20"/>
                
                <!-- FILTERS -->
                <controls:OperationalFilters Grid.Row="2"
                                            Margin="0,0,0,20"/>

                <!-- EMPTY STATE -->
                <controls:OperationalEmptyState Grid.Row="3"/>

                <!-- GRID -->
                <DataGrid Grid.Row="3"
                          ItemsSource="{Binding Plantas}"
                          SelectedItem="{Binding PlantaSeleccionada}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowHeight="38"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="#E2E8F0"
                          Visibility="{Binding HasData,
                                        Converter={StaticResource BoolToVisibilityConverter}}">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding Codigo,
                                                    StringFormat=D5}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Código Operacional"
                                            Binding="{Binding CodigoOperacional}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Última Actualización"
                                            Binding="{Binding FechaUltimaActualizacion,
                                                StringFormat=dd-MM-yyyy HH:mm}"
                                            Width="220"/>

                    </DataGrid.Columns>
                </DataGrid>

                <!-- LOADING OVERLAY -->
                <controls:OperationalLoadingOverlay Grid.RowSpan="5"/>

                <!-- PAGINACIÓN -->
                <controls:OperationalPagination Grid.Row="4"
                                                Margin="0,20,0,0"/>
                
            </Grid>
        </Border>
    </Grid>
</UserControl>