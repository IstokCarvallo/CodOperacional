<UserControl x:Class="DesktopCodOperacional.Views.PlantasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopCodOperacional.Controls">

    <Grid Margin="20">

        <Border Padding="20"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- TOOLBAR -->

                <controls:OperationalToolbar Grid.Row="0"
                                             Margin="0,0,0,20"/>

                <!-- GRID -->

                <DataGrid Grid.Row="2"
                          ItemsSource="{Binding Plantas}"
                          SelectedItem="{Binding PlantaSeleccionada}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          SelectionMode="Single"
                          BorderThickness="0"
                          HeadersVisibility="Column"
                          RowHeight="38"
                          AlternatingRowBackground="#F8FAFC"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E2E8F0"
                          VerticalGridLinesBrush="#E2E8F0">

                    <DataGrid.Columns>

                        <DataGridTextColumn Header="Código"
                                            Binding="{Binding Codigo}"
                                            Width="120"/>

                        <DataGridTextColumn Header="Nombre"
                                            Binding="{Binding Nombre}"
                                            Width="*"/>

                        <DataGridTextColumn Header="Código Operacional"
                                            Binding="{Binding CodigoOperacional}"
                                            Width="180"/>

                        <DataGridTextColumn Header="Última Actualización"
                                            Binding="{Binding FechaUltimaActualizacion}"
                                            Width="220"/>

                    </DataGrid.Columns>

                </DataGrid>
                
                <!-- LOADING -->

                <Border Background="#80FFFFFF"
                        Visibility="{Binding Cargando,
                        Converter={StaticResource BoolToVisibilityConverter}}">

                    <ProgressBar Width="220"
                                 Height="6"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"/>
                </Border>

                <!-- PAGINACIÓN -->

                <StackPanel Grid.Row="3"
                            Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            Margin="0,20,0,0">

                    <Button Content="Anterior"
                            Width="100"
                            Height="36"
                            Command="{Binding PaginaAnteriorCommand}"/>

                    <TextBlock Text="{Binding PaginaActual}"
                               VerticalAlignment="Center"
                               Margin="14,0,4,0"
                               FontWeight="SemiBold"/>

                    <TextBlock Text="/"
                               VerticalAlignment="Center"/>

                    <TextBlock Text="{Binding TotalPaginas}"
                               VerticalAlignment="Center"
                               Margin="4,0,14,0"
                               FontWeight="SemiBold"/>

                    <Button Content="Siguiente"
                            Width="100"
                            Height="36"
                            Command="{Binding SiguientePaginaCommand}"/>

                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>