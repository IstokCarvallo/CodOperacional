<Window x:Class="DesktopCodOperacional.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopCodOperacional.Views"
        xmlns:models="clr-namespace:DesktopCodOperacional.Models.Menu"
        mc:Ignorable="d"
        Title="ShellWindow" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- SIDEBAR -->
        <Border Grid.Column="0"
            Background="#111827">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- HEADER -->

                <StackPanel Orientation="Horizontal"
                            Margin="20">

                    <Border Width="52"
                            Height="52"
                            CornerRadius="14"
                            Background="#2563EB">

                        <TextBlock Text="CO"
                               Foreground="White"
                               FontWeight="Bold"
                               FontSize="18"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                    </Border>

                    <StackPanel Margin="14,0,0,0"
                                VerticalAlignment="Center">

                        <TextBlock Text="Código Operacional"
                                   Foreground="White"
                                   FontSize="16"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="{Binding CurrentRole}"
                                   Foreground="#94A3B8"
                                   FontSize="12"/>
                    </StackPanel>
                </StackPanel>

                <!-- MENU -->

                <TreeView Grid.Row="1"
                          ItemsSource="{Binding MenuItems}"
                          Background="Transparent"
                          BorderThickness="0"
                          Padding="10">

                    <TreeView.Resources>

                        <HierarchicalDataTemplate DataType="{x:Type models:MenuItemModel}"
                                                 ItemsSource="{Binding Children}">

                            <Button Background="Transparent"
                                    BorderThickness="0"
                                    Padding="12"
                                    HorizontalContentAlignment="Left"
                                    Cursor="Hand"
                                    Command="{Binding DataContext.NavigateMenuCommand,
                                    RelativeSource={RelativeSource AncestorType=TreeView}}"
                                    CommandParameter="{Binding}">

                                <StackPanel Orientation="Horizontal">

                                    <TextBlock Text="{Binding Icon}"
                                               FontFamily="Segoe MDL2 Assets"
                                               Foreground="White"
                                               FontSize="16"/>

                                    <TextBlock Text="{Binding Title}"
                                               Foreground="White"
                                               Margin="14,0,0,0"
                                               FontSize="14"/>

                                </StackPanel>

                            </Button>

                        </HierarchicalDataTemplate>

                    </TreeView.Resources>
                </TreeView>
            </Grid>
        </Border>

        <!-- CONTENT -->
        <Grid Grid.Column="1"
              Background="#F1F5F9">

            <Grid.RowDefinitions>
                <RowDefinition Height="70"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- TOPBAR -->
            <Border Grid.Row="0"
                    Background="White"
                    BorderBrush="#E2E8F0"
                    BorderThickness="0,0,0,1">

                <Grid Margin="20,0">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- TÍTULO -->
                    <TextBlock Text="{Binding Titulo}"
                               FontSize="24"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"/>

                    <!-- ACCIONES USUARIO -->
                    <StackPanel Grid.Column="1"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">

                        <!-- BOTÓN LOGOUT -->
                        <Button Content="Cerrar sesión"
                                Command="{Binding LogoutCommand}"
                                Margin="0,0,10,0"
                                Padding="12,6"
                                Background="#EF4444"
                                Foreground="White"
                                BorderThickness="0"/>

                    </StackPanel>

                </Grid>

            </Border>
            
            <!-- CONTENT AREA -->
            <ContentControl Grid.Row="1" 
                            Content="{Binding Navigation.CurrentView}"/>

        </Grid>

    </Grid>
    
</Window>
