<Window x:Class="DesktopCodOperacional.Views.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DesktopCodOperacional.Views"
        xmlns:models="clr-namespace:DesktopCodOperacional.Models.Menu"
        mc:Ignorable="d"
        Title="ShellWindow" Height="800" Width="1400"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">

    <Grid Background="#F1F5F9">

        <Grid.RowDefinitions>
            <RowDefinition Height="72"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding SidebarWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- HEADER -->

        <Border Grid.Row="0"
            Grid.Column="1"
            Background="White"
            BorderBrush="#E2E8F0"
            BorderThickness="0,0,0,1">

            <Grid Margin="24,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- LEFT -->

                <StackPanel VerticalAlignment="Center">

                    <TextBlock Text="{Binding Titulo}"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#0F172A"/>

                    <TextBlock Text="{Binding CurrentDate}"
                           FontSize="12"
                           Foreground="#64748B"/>
                </StackPanel>

                <!-- RIGHT -->

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <!-- SEARCH -->

                    <Border Width="260"
                        Height="40"
                        CornerRadius="12"
                        Background="#F8FAFC"
                        Margin="0,0,20,0">

                        <Grid Margin="14,0">

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <TextBlock Text="&#xE721;"
                                   FontFamily="Segoe MDL2 Assets"
                                   VerticalAlignment="Center"
                                   Foreground="#64748B"/>

                            <TextBox Grid.Column="1"
                                 Margin="10,0,0,0"
                                 BorderThickness="0"
                                 Background="Transparent"
                                 VerticalContentAlignment="Center"
                                 FontSize="13"
                                 Foreground="#0F172A"/>
                        </Grid>
                    </Border>

                    <!-- NOTIFICATION -->

                    <Border Width="42"
                        Height="42"
                        CornerRadius="12"
                        Background="#F8FAFC"
                        Margin="0,0,16,0">

                        <TextBlock Text="&#xE7F4;"
                               FontFamily="Segoe MDL2 Assets"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="16"
                               Foreground="#475569"/>
                    </Border>

                    <!-- USER -->

                    <Border Background="#F8FAFC"
                        CornerRadius="14"
                        Padding="14,10">

                        <StackPanel Orientation="Horizontal">

                            <!-- AVATAR -->

                            <Border Width="40"
                                Height="40"
                                CornerRadius="20"
                                Background="#2563EB">

                                <TextBlock Text="{Binding CurrentUser,
                                      StringFormat={}{0:0}}"
                                       Foreground="White"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                            </Border>

                            <!-- INFO -->

                            <StackPanel Margin="12,0,0,0">

                                <TextBlock Text="{Binding CurrentUser}"
                                       FontWeight="SemiBold"
                                       FontSize="13"
                                       Foreground="#0F172A"/>

                                <TextBlock Text="{Binding CurrentRole}"
                                       FontSize="11"
                                       Foreground="#64748B"/>
                            </StackPanel>

                            <!-- LOGOUT -->

                            <Button Width="40"
                                    Height="40"
                                    Margin="20,0,0,0"
                                    Cursor="Hand"
                                    BorderThickness="0"
                                    Background="#FEF2F2"
                                    ToolTip="Cerrar sesión"
                                    Command="{Binding LogoutCommand}">

                                <Button.Content>
                                    <TextBlock Text="&#xE8A0;"
                                               FontFamily="Segoe MDL2 Assets"
                                               FontSize="16"
                                               Foreground="#DC2626"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Button.Content>

                                <Button.Style>
                                    <Style TargetType="Button">
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">

                                                    <Border Background="{TemplateBinding Background}"
                                                            CornerRadius="12">

                                                        <ContentPresenter HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"/>

                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>

                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver"
                                                    Value="True">

                                                <Setter Property="Background"
                                                        Value="#FEE2E2"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>

                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- SIDEBAR -->

        <Border Grid.Row="0"
        Grid.RowSpan="2"
        Grid.Column="0"
        Background="#0F172A">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="72"/>
                    <RowDefinition Height="90"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- TOP BAR -->

                <Grid Grid.Row="0"
              Margin="18,0">

                    <Button Width="42"
                    Height="42"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="#1E293B"
                    BorderThickness="0"
                    Cursor="Hand"
                    Command="{Binding ToggleSidebarCommand}">

                        <Button.Style>
                            <Style TargetType="Button">

                                <Setter Property="Template">

                                    <Setter.Value>

                                        <ControlTemplate TargetType="Button">

                                            <Border Background="{TemplateBinding Background}"
                                            CornerRadius="12">

                                                <ContentPresenter HorizontalAlignment="Center"
                                                          VerticalAlignment="Center"/>

                                            </Border>

                                        </ControlTemplate>

                                    </Setter.Value>

                                </Setter>

                                <Style.Triggers>

                                    <Trigger Property="IsMouseOver"
                                     Value="True">

                                        <Setter Property="Background"
                                        Value="#334155"/>

                                    </Trigger>

                                </Style.Triggers>

                            </Style>
                        </Button.Style>

                        <TextBlock Text="&#xE700;"
                           FontFamily="Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="White"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    </Button>

                </Grid>

                <!-- LOGO -->

                <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    Margin="24,0"
                    VerticalAlignment="Center">

                    <!-- ICON -->

                    <Border Width="52"
                    Height="52"
                    CornerRadius="16"
                    Background="#2563EB">

                        <TextBlock Text="CO"
                           Foreground="White"
                           FontWeight="Bold"
                           FontSize="18"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"/>

                    </Border>

                    <!-- TEXT -->

                    <StackPanel Margin="14,0,0,0"
                        VerticalAlignment="Center">

                        <StackPanel.Style>
                            <Style TargetType="StackPanel">

                                <Setter Property="Visibility"
                                Value="Visible"/>

                                <Style.Triggers>

                                    <DataTrigger Binding="{Binding IsSidebarCollapsed}"
                                         Value="True">

                                        <Setter Property="Visibility"
                                        Value="Collapsed"/>

                                    </DataTrigger>

                                </Style.Triggers>

                            </Style>
                        </StackPanel.Style>

                        <TextBlock Text="Código Operacional"
                           Foreground="White"
                           FontWeight="SemiBold"
                           FontSize="16"/>

                        <TextBlock Text="RIOblanco SPA"
                           Foreground="#94A3B8"
                           FontSize="12"/>

                    </StackPanel>

                </StackPanel>

                <!-- MENU -->

                <TreeView Grid.Row="2"
                  ItemsSource="{Binding MenuItems}"
                  Background="Transparent"
                  BorderThickness="0"
                  Padding="14">

                    <TreeView.Resources>

                        <Style TargetType="TreeViewItem">

                            <Setter Property="Background"
                            Value="Transparent"/>

                            <Setter Property="BorderThickness"
                            Value="0"/>

                            <Setter Property="Padding"
                            Value="0"/>

                            <Setter Property="Margin"
                            Value="0,4"/>

                        </Style>

                        <HierarchicalDataTemplate DataType="{x:Type models:MenuItemModel}"
                                          ItemsSource="{Binding Children}">

                            <Button Background="Transparent"
                            BorderThickness="0"
                            Padding="14"
                            Cursor="Hand"
                            HorizontalContentAlignment="Left"
                            Command="{Binding DataContext.NavigateMenuCommand,
                            RelativeSource={RelativeSource AncestorType=TreeView}}"
                            CommandParameter="{Binding}">

                                <Button.Style>
                                    <Style TargetType="Button">

                                        <Setter Property="Template">

                                            <Setter.Value>

                                                <ControlTemplate TargetType="Button">

                                                    <Border x:Name="Container"
                                                    Background="Transparent"
                                                    CornerRadius="12"
                                                    Padding="{TemplateBinding Padding}">

                                                        <ContentPresenter/>

                                                    </Border>

                                                    <ControlTemplate.Triggers>

                                                        <Trigger Property="IsMouseOver"
                                                         Value="True">

                                                            <Setter TargetName="Container"
                                                            Property="Background"
                                                            Value="#1E293B"/>

                                                        </Trigger>

                                                    </ControlTemplate.Triggers>

                                                </ControlTemplate>

                                            </Setter.Value>

                                        </Setter>

                                    </Style>
                                </Button.Style>

                                <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left">

                                    <!-- ICON -->

                                    <TextBlock Text="{Binding Icon}"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="White"
                                       FontSize="16"
                                       Width="24"
                                       TextAlignment="Center"
                                       VerticalAlignment="Center"/>

                                    <!-- TITLE -->

                                    <TextBlock Text="{Binding Title}"
                                       Margin="14,0,0,0"
                                       Foreground="White"
                                       FontSize="14"
                                       VerticalAlignment="Center">

                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">

                                                <Setter Property="Visibility"
                                                Value="Visible"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding DataContext.IsSidebarCollapsed,
                                            RelativeSource={RelativeSource AncestorType=Window}}"
                                                         Value="True">

                                                        <Setter Property="Visibility"
                                                        Value="Collapsed"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>
                                        </TextBlock.Style>

                                    </TextBlock>

                                </StackPanel>

                            </Button>

                        </HierarchicalDataTemplate>

                    </TreeView.Resources>

                </TreeView>

            </Grid>

        </Border>

        <!-- CONTENT -->

        <Border Grid.Row="1"
            Grid.Column="1"
            Margin="20"
            CornerRadius="20"
            Background="White">

            <ContentControl Content="{Binding Navigation.CurrentView}"/>

        </Border>

    </Grid>

</Window>
