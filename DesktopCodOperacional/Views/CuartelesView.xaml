<UserControl x:Class="DesktopCodOperacional.Views.CuartelesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:DesktopCodOperacional.Controls">

    <Grid Margin="20">

        <Border Padding="20"
                Background="White"
                CornerRadius="16"
                BorderBrush="#E2E8F0"
                BorderThickness="1">

            <Grid>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FILTROS -->
                <Grid Grid.Row="0"
                      Margin="0,0,0,20">

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="20"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- PRODUCTOR -->
                    <StackPanel Grid.Column="0">

                        <TextBlock Text="Productor"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,8"/>

                        <TextBox Height="38"
                                 Padding="10,0"
                                 BorderBrush="#CBD5E1"
                                 Text="{Binding FiltroProductor,
                                 UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox Height="40"
                                  Margin="0,10,0,0"
                                  Padding="8,0"
                                  BorderBrush="#CBD5E1"
                                  ItemsSource="{Binding ProductoresFiltrados}"
                                  SelectedItem="{Binding ProductorSeleccionado}"
                                  DisplayMemberPath="Display"/>

                    </StackPanel>

                    <!-- PREDIO -->
                    <StackPanel Grid.Column="2">

                        <TextBlock Text="Predio"
                                   FontWeight="SemiBold"
                                   Foreground="#334155"
                                   Margin="0,0,0,8"/>

                        <TextBox Height="38"
                                 Padding="10,0"
                                 BorderBrush="#CBD5E1"
                                 Text="{Binding FiltroPredio,
                                 UpdateSourceTrigger=PropertyChanged}"/>

                        <ComboBox Height="40"
                                  Margin="0,10,0,0"
                                  Padding="8,0"
                                  BorderBrush="#CBD5E1"
                                  ItemsSource="{Binding PrediosFiltrados}"
                                  SelectedItem="{Binding PredioSeleccionado}"
                                  DisplayMemberPath="Display"/>

                    </StackPanel>

                </Grid>

                <!-- TOOLBAR -->
                <controls:OperationalToolbar Grid.Row="1"
                                             Margin="0,0,0,20"/>

                <!-- BODY -->
                <Grid Grid.Row="2">

                    <!-- GRID -->
                    <Border BorderBrush="#E2E8F0"
                            BorderThickness="1"
                            CornerRadius="12">

                        <DataGrid ItemsSource="{Binding Cuarteles}"
                                  SelectedItem="{Binding CuartelSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  HeadersVisibility="Column"
                                  BorderThickness="0"
                                  RowHeight="38"
                                  AlternatingRowBackground="#F8FAFC"
                                  GridLinesVisibility="Horizontal"
                                  HorizontalGridLinesBrush="#E2E8F0"
                                  VerticalGridLinesBrush="#E2E8F0">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Cuartel"
                                                    Binding="{Binding CodigoCuartel,
                                                    StringFormat=D3}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Nombre"
                                                    Binding="{Binding Nombre}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Código Operacional"
                                                    Binding="{Binding CodigoOperacional}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Última Actualización"
                                                    Binding="{Binding FechaUltimaActualizacion,
                                                    StringFormat=dd-MM-yyyy HH:mm}"
                                                    Width="220"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </Border>

                    <!-- EMPTY STATE -->
                    <controls:OperationalEmptyState
                        Visibility="{Binding HasData,
                        Converter={StaticResource BoolToVisibilityConverter},
                        ConverterParameter=Inverse}"/>

                    
                     <!--LOADING--> 
                    <controls:OperationalLoadingOverlay
                        Visibility="{Binding Cargando,
                        Converter={StaticResource BoolToVisibilityConverter}}"/>

                </Grid>

            </Grid>

        </Border>

    </Grid>

</UserControl>