<UserControl x:Class="DesktopCodOperacional.Views.CuartelesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- FILTROS -->
        <Border Grid.Row="0" 
                Padding="20"
                Background="White"
                CornerRadius="12">

            <StackPanel>

                <TextBlock Text="Productor"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8"/>

                <TextBox Height="36"
                         Margin="0,0,0,10"
                         Text="{Binding FiltroProductor,
                    UpdateSourceTrigger=PropertyChanged}"/>

                <ComboBox Height="38"
                          ItemsSource="{Binding ProductoresFiltrados}"
                          SelectedItem="{Binding ProductorSeleccionado}"
                          DisplayMemberPath="Display"/>

                <TextBlock Text="Predio"
                           FontWeight="SemiBold"
                           Margin="0,20,0,8"/>                

                <TextBox Height="36"
                         Margin="0,0,0,10"
                         Text="{Binding FiltroPredio,
                    UpdateSourceTrigger=PropertyChanged}"/>               

                <ComboBox Height="38"
                          ItemsSource="{Binding PrediosFiltrados}"
                          SelectedItem="{Binding PredioSeleccionado}"
                          DisplayMemberPath="Display"/>

                <!-- GRID CUARTELES -->

                <Border Grid.Row="1"
                        Margin="0,20,0,0"
                        Padding="12"
                        Background="White"
                        CornerRadius="12">

                    <StackPanel>

                        <Button Content="Editar Código"
                                Width="160"
                                Height="40"
                                Margin="0,0,0,12"
                                HorizontalAlignment="Left"
                                Command="{Binding EditarCodigoCommand}"/>

                        <DataGrid ItemsSource="{Binding Cuarteles}"
                                  SelectedItem="{Binding CuartelSeleccionado}"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">

                            <DataGrid.Columns>

                                <DataGridTextColumn Header="Productor"
                                                    Binding="{Binding Productor}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Predio"
                                                    Binding="{Binding Predio}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Cuartel"
                                                    Binding="{Binding CodigoCuartel}"
                                                    Width="120"/>

                                <DataGridTextColumn Header="Nombre"
                                                    Binding="{Binding Nombre}"
                                                    Width="*"/>

                                <DataGridTextColumn Header="Código Operacional"
                                                    Binding="{Binding CodigoOperacional}"
                                                    Width="180"/>

                                <DataGridTextColumn Header="Última Actualización"
                                                    Binding="{Binding FechaUltimaActualizacion}"
                                                    Width="220"/>

                            </DataGrid.Columns>

                        </DataGrid>

                    </StackPanel>

                </Border>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>