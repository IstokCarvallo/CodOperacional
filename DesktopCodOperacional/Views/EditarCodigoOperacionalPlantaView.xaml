<Window x:Class="DesktopCodOperacional.Views.EditarCodigoOperacionalPlantaView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        SizeToContent="WidthAndHeight">

    <Border Background="White"
            CornerRadius="18"
            Padding="24">

        <Grid Width="420">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Editar Código Operacional"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Margin="0,0,0,20"/>

            <StackPanel Grid.Row="1">

                <TextBlock Text="Planta"/>

                <TextBox Text="{Binding Nombre}"
                         IsReadOnly="True"
                         Height="38"/>
            </StackPanel>

            <StackPanel Grid.Row="2"
                        Margin="0,18,0,0">

                <TextBlock Text="Código Operacional"/>

                <TextBox Text="{Binding CodigoOperacional,
                         UpdateSourceTrigger=PropertyChanged}"
                         Height="38"
                         MaxLength="10"/>
            </StackPanel>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,24,0,0">

                <Button Content="Cancelar"
                        Width="100"
                        Margin="0,0,10,0"
                        Command="{Binding CancelarCommand}"/>

                <Button Content="Guardar"
                        Width="120"
                        Command="{Binding GuardarCommand}"/>
            </StackPanel>

        </Grid>

    </Border>
</Window>