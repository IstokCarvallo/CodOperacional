<UserControl x:Class="DesktopCodOperacional.Views.AuditoriasView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="clr-namespace:DesktopCodOperacional.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <Grid Margin="16"
          Background="#F8FAFC">

        <Grid.RowDefinitions>
            <!-- TITULO -->
            <RowDefinition Height="Auto"/>

            <!-- TOOLBAR -->
            <RowDefinition Height="Auto"/>

            <!-- FILTROS -->
            <RowDefinition Height="Auto"/>

            <!-- ESPACIO -->
            <RowDefinition Height="12"/>

            <!-- GRID -->
            <RowDefinition Height="*"/>

        </Grid.RowDefinitions>

        <!-- =========================================================
             TITULO
        ========================================================= -->

        <TextBlock Grid.Row="0"
                   Text="Auditoría"
                   FontSize="24"
                   FontWeight="SemiBold"
                   Foreground="#0F172A"
                   Margin="0,0,0,14"/>

        <!-- TOOLBAR -->

        <controls:OperationalToolbar Grid.Row="1"
                             Margin="0,0,0,12"/>

        <!-- FILTROS -->

        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12"
                Padding="14">

            <Grid>

                <Grid.ColumnDefinitions>

                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="140"/>
                    <ColumnDefinition Width="*"/>

                </Grid.ColumnDefinitions>

                <!-- DESDE -->

                <StackPanel Grid.Column="0"
                            Margin="0,0,10,0">

                    <TextBlock Text="Desde"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,4"/>

                    <DatePicker SelectedDate="{Binding Desde}"
                                MinHeight="34"/>
                </StackPanel>

                <!-- HASTA -->

                <StackPanel Grid.Column="1"
                            Margin="0,0,10,0">

                    <TextBlock Text="Hasta"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,4"/>

                    <DatePicker SelectedDate="{Binding Hasta}"
                                MinHeight="34"/>
                </StackPanel>

                <!-- USUARIO -->

                <StackPanel Grid.Column="2"
                            Margin="0,0,10,0">

                    <TextBlock Text="Usuario"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,4"/>

                    <TextBox Text="{Binding Usuario,
                                            UpdateSourceTrigger=PropertyChanged}"
                             Height="34"
                             Padding="8,0"
                             VerticalContentAlignment="Center">

                        <TextBox.InputBindings>

                            <KeyBinding Key="Enter"
                                        Command="{Binding BuscarCommand}"/>

                        </TextBox.InputBindings>

                    </TextBox>

                </StackPanel>

                <!-- ENTIDAD -->

                <StackPanel Grid.Column="3"
                            Margin="0,0,10,0">

                    <TextBlock Text="Entidad"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,4"/>

                    <ComboBox SelectedItem="{Binding Entidad}"
                              SelectedIndex="-1"
                              Height="34">

                        <sys:String>PLANTA</sys:String>
                        <sys:String>CUARTEL</sys:String>
                        <sys:String>USUARIO</sys:String>

                    </ComboBox>

                </StackPanel>

                <!-- ACCION -->

                <StackPanel Grid.Column="4">

                    <TextBlock Text="Acción"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="#475569"
                               Margin="0,0,0,4"/>

                    <ComboBox SelectedItem="{Binding Accion}"
                              SelectedIndex="-1"
                              Height="34">

                        <sys:String>UPDATE</sys:String>
                        <sys:String>CREATE</sys:String>
                        <sys:String>DELETE</sys:String>

                    </ComboBox>

                </StackPanel>

            </Grid>

        </Border>

        <!-- =========================================================
             GRID
        ========================================================= -->

        <Border Grid.Row="4"
                Background="White"
                BorderBrush="#E2E8F0"
                BorderThickness="1"
                CornerRadius="12">

            <Grid>

                <!-- =====================================================
                     DATAGRID
                ===================================================== -->

                <DataGrid Margin="10"
                          ItemsSource="{Binding Auditorias}"
                          SelectedItem="{Binding SelectedAuditoria}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          HeadersVisibility="Column"
                          SelectionMode="Single"
                          RowHeight="30"
                          GridLinesVisibility="None"
                          BorderThickness="0"
                          Background="White"
                          AlternatingRowBackground="#FAFAFA"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          CanUserResizeRows="False"
                          CanUserSortColumns="True"
                          EnableRowVirtualization="True"
                          EnableColumnVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          ScrollViewer.CanContentScroll="True"
                          ScrollViewer.VerticalScrollBarVisibility="Auto"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">

                    <!-- =====================================================
                         ESTILOS
                    ===================================================== -->

                    <DataGrid.Resources>

                        <!-- HEADER -->

                        <Style TargetType="DataGridColumnHeader">

                            <Setter Property="Background"
                                    Value="#F8FAFC"/>

                            <Setter Property="Foreground"
                                    Value="#334155"/>

                            <Setter Property="FontWeight"
                                    Value="SemiBold"/>

                            <Setter Property="FontSize"
                                    Value="11"/>

                            <Setter Property="Height"
                                    Value="30"/>

                            <Setter Property="Padding"
                                    Value="8,0"/>

                            <Setter Property="BorderBrush"
                                    Value="#E2E8F0"/>

                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1"/>

                        </Style>

                        <!-- ROW -->

                        <Style TargetType="DataGridRow">

                            <Setter Property="Background"
                                    Value="White"/>

                            <Setter Property="BorderBrush"
                                    Value="#F1F5F9"/>

                            <Setter Property="BorderThickness"
                                    Value="0,0,0,1"/>

                            <Setter Property="SnapsToDevicePixels"
                                    Value="True"/>

                            <Style.Triggers>

                                <!-- HOVER -->

                                <Trigger Property="IsMouseOver"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#F8FAFC"/>

                                </Trigger>

                                <!-- SELECTED -->

                                <Trigger Property="IsSelected"
                                         Value="True">

                                    <Setter Property="Background"
                                            Value="#EFF6FF"/>

                                    <Setter Property="Foreground"
                                            Value="Black"/>

                                </Trigger>

                            </Style.Triggers>

                        </Style>

                        <!-- CELL -->

                        <Style TargetType="DataGridCell">

                            <Setter Property="Padding"
                                    Value="8,0"/>

                            <Setter Property="BorderThickness"
                                    Value="0"/>

                            <Setter Property="VerticalContentAlignment"
                                    Value="Center"/>

                        </Style>

                    </DataGrid.Resources>

                    <!-- =====================================================
                         COLUMNAS
                    ===================================================== -->

                    <DataGrid.Columns>

                        <!-- FECHA -->

                        <DataGridTextColumn Header="Fecha"
                                            Width="145"
                                            Binding="{Binding Fecha,
                                                              StringFormat=dd-MM-yyyy HH:mm}"/>

                        <!-- USUARIO -->

                        <DataGridTextColumn Header="Usuario"
                                            Width="100"
                                            Binding="{Binding Usuario}"/>

                        <!-- ENTIDAD -->

                        <DataGridTemplateColumn Header="Entidad"
                                                Width="90">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border Padding="5,0"
                                            Height="20"
                                            MinWidth="54"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                        Value="#E5E7EB"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Entidad}"
                                                                 Value="PLANTA">

                                                        <Setter Property="Background"
                                                                Value="#DBEAFE"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Entidad}"
                                                                 Value="CUARTEL">

                                                        <Setter Property="Background"
                                                                Value="#E9D5FF"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Entidad}"
                                                                 Value="USUARIO">

                                                        <Setter Property="Background"
                                                                Value="#FDE68A"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <TextBlock Text="{Binding Entidad}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <!-- ACCION -->

                        <DataGridTemplateColumn Header="Acción"
                                                Width="90">

                            <DataGridTemplateColumn.CellTemplate>

                                <DataTemplate>

                                    <Border Padding="5,0"
                                            Height="20"
                                            MinWidth="54"
                                            CornerRadius="6"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center">

                                        <Border.Style>

                                            <Style TargetType="Border">

                                                <Setter Property="Background"
                                                        Value="#E5E7EB"/>

                                                <Style.Triggers>

                                                    <DataTrigger Binding="{Binding Accion}"
                                                                 Value="UPDATE">

                                                        <Setter Property="Background"
                                                                Value="#FEF3C7"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Accion}"
                                                                 Value="CREATE">

                                                        <Setter Property="Background"
                                                                Value="#DCFCE7"/>

                                                    </DataTrigger>

                                                    <DataTrigger Binding="{Binding Accion}"
                                                                 Value="DELETE">

                                                        <Setter Property="Background"
                                                                Value="#FEE2E2"/>

                                                    </DataTrigger>

                                                </Style.Triggers>

                                            </Style>

                                        </Border.Style>

                                        <TextBlock Text="{Binding Accion}"
                                                   FontSize="9"
                                                   FontWeight="SemiBold"
                                                   HorizontalAlignment="Center"
                                                   VerticalAlignment="Center"/>

                                    </Border>

                                </DataTemplate>

                            </DataGridTemplateColumn.CellTemplate>

                        </DataGridTemplateColumn>

                        <!-- CLAVE -->

                        <DataGridTextColumn Header="Clave"
                                            Width="270"
                                            Binding="{Binding Clave}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="FontFamily"
                                            Value="Consolas"/>

                                    <Setter Property="FontSize"
                                            Value="11"/>

                                    <Setter Property="Foreground"
                                            Value="#334155"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                        <!-- CAMPO -->

                        <DataGridTextColumn Header="Campo"
                                            Width="150"
                                            Binding="{Binding Campo}"/>

                        <!-- VALOR ANTERIOR -->

                        <DataGridTextColumn Header="Valor Anterior"
                                            Width="140"
                                            Binding="{Binding ValorAnterior}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Foreground"
                                            Value="#DC2626"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                        <!-- VALOR NUEVO -->

                        <DataGridTextColumn Header="Valor Nuevo"
                                            Width="140"
                                            Binding="{Binding ValorNuevo}">

                            <DataGridTextColumn.ElementStyle>

                                <Style TargetType="TextBlock">

                                    <Setter Property="Foreground"
                                            Value="#059669"/>

                                    <Setter Property="FontWeight"
                                            Value="SemiBold"/>

                                </Style>

                            </DataGridTextColumn.ElementStyle>

                        </DataGridTextColumn>

                    </DataGrid.Columns>

                    <!-- =====================================================
                         DOBLE CLICK
                    ===================================================== -->

                    <DataGrid.InputBindings>

                        <MouseBinding MouseAction="LeftDoubleClick"
                                      Command="{Binding VerDetalleCommand}"/>

                    </DataGrid.InputBindings>

                </DataGrid>

                <!-- =====================================================
                     LOADING
                ===================================================== -->

                <Border Background="#80FFFFFF"
                        Visibility="{Binding IsLoading,
                                             Converter={StaticResource BooleanToVisibilityConverter}}">

                    <ProgressBar Width="180"
                                 Height="6"
                                 IsIndeterminate="True"
                                 VerticalAlignment="Center"/>

                </Border>

            </Grid>

        </Border>

    </Grid>

</UserControl>