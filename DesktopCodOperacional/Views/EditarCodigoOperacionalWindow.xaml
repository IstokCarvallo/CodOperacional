<Window x:Class="DesktopCodOperacional.Views.EditarCodigoOperacionalWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Código Operacional"
        Height="320"
        Width="500"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">

    <Grid Margin="20">

        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- HEADER -->

        <StackPanel>

            <TextBlock Text="Editar Código Operacional"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <TextBlock Text="{Binding NombreCuartel}"
                       Margin="0,10,0,0"
                       FontSize="16"/>

        </StackPanel>

        <!-- BODY -->

        <StackPanel Grid.Row="1"
                    Margin="0,30,0,0">

            <TextBlock Text="Código Operacional"
                       FontWeight="SemiBold"
                       Margin="0,0,0,8"/>

            <TextBox Height="42"
                     FontSize="18"
                     CharacterCasing="Upper"
                     MaxLength="20"
                     Text="{Binding CodigoOperacional,
                            UpdateSourceTrigger=PropertyChanged}"/>

        </StackPanel>

        <!-- FOOTER -->
        <StackPanel Grid.Row="2"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right">

            <Button Content="Cancelar"
                    Width="120"
                    Height="40"
                    Margin="0,0,10,0"
                    Command="{Binding CancelarCommand}"/>

            <Button Content="Guardar"
                    Width="120"
                    Height="40"
                    Command="{Binding GuardarCommand}"/>

        </StackPanel>

    </Grid>

</Window>